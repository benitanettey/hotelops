<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-gray-50">
  
  <div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl w-full space-y-8">
      
      <!-- Logo and Header -->
      <div class="text-center">
        <div class="flex items-center justify-center gap-3 mb-2">
          <div class="bg-[#008080] text-white p-3 rounded-lg">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
            </svg>
          </div>
        </div>
        <h1 class="text-3xl font-bold text-gray-900">Save Your Recovery Codes</h1>
        <p class="mt-2 text-sm text-gray-600">Account created successfully for: <span class="font-semibold">{{username}}</span></p>
      </div>

      <!-- Warning Message -->
      <div class="bg-white rounded-lg shadow-md p-8">
        
        <div class="mb-6 bg-yellow-50 border-l-4 border-yellow-400 p-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-yellow-800">Warning: One-Time Display</h3>
              <div class="mt-2 text-sm text-yellow-700">
                <p>These codes will only be shown <strong>ONCE</strong>. Save them now in a safe place!</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Recovery Codes -->
        <div class="mb-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Your Recovery Codes:</h2>
          <p class="text-sm text-gray-600 mb-4">Use these codes to reset your password if you forget it. Each code can only be used once.</p>
          
          <div class="bg-gray-50 border-2 border-gray-300 rounded-lg p-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
              {{#each codes}}
              <div class="bg-white border-2 border-[#008080] rounded-lg p-4 text-center font-mono text-lg font-bold text-gray-800 select-all">
                {{this}}
              </div>
              {{/each}}
            </div>
          </div>
        </div>

        <!-- Instructions -->
        <div class="mb-6 bg-blue-50 border border-blue-200 rounded-lg p-4">
          <h3 class="text-sm font-semibold text-blue-900 mb-2">How to save your codes:</h3>
          <ul class="text-sm text-blue-800 space-y-1 list-disc list-inside">
            <li>Write them down on paper and store in a safe place</li>
            <li>Take a screenshot and save in a secure folder</li>
            <li>Print this page using Ctrl+P (Cmd+P on Mac)</li>
            <li>Do NOT share these codes with anyone</li>
          </ul>
        </div>

        <!-- Print Button -->
        <div class="flex gap-3 print:hidden">
          <button 
            onclick="window.print()"
            type="button"
            class="flex-1 bg-gray-600 text-white px-6 py-3 rounded-lg hover:bg-gray-700 transition font-medium"
          >
            🖨️ Print Codes
          </button>
          
          <!-- Continue Button -->
          <form method="POST" action="/recovery-codes/continue" class="flex-1">
            <button 
              type="submit"
              class="w-full bg-[#008080] text-white px-6 py-3 rounded-lg hover:bg-teal-700 transition font-medium"
            >
              I've Saved My Codes - Continue
            </button>
          </form>
        </div>

      </div>

      <!-- Print-only Section -->
      <div class="hidden print:block bg-white p-8 border-2 border-gray-300">
        <h2 class="text-xl font-bold mb-4">StaySync Recovery Codes</h2>
        <p class="mb-2"><strong>Username:</strong> {{username}}</p>
        <p class="mb-4"><strong>Created:</strong> {{formatDate}}</p>
        <p class="text-sm text-gray-600 mb-4">Keep this document in a safe place. Each code can be used only once to recover your password.</p>
      </div>

    </div>
  </div>

</body>
</html>
