<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="min-h-screen flex items-center justify-center relative overflow-y-auto py-8">
  
  <!-- Background with overlays -->
  <div class="fixed inset-0 z-0">
    <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1920&q=80" alt="Hotel lobby" class="w-full h-full object-cover filter blur-sm">
    <div class="absolute inset-0 bg-[#008080]/80"></div>
    <div class="absolute inset-0 bg-gradient-to-br from-[#008080]/60 to-teal-900/80"></div>
  </div>

  <div class="relative z-10 w-full max-w-md p-4">
    <div class="bg-white rounded-xl shadow-2xl p-8 space-y-5">
      
      <!-- Logo and Header -->
      <div class="text-center">
        <div class="flex items-center justify-center gap-3 mb-2">
          <div class="bg-[#008080] text-white p-3 rounded-lg shadow-lg">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
          </div>
        </div>
        <h1 class="text-3xl font-bold text-gray-900">StaySync</h1>
        <p class="mt-2 text-sm text-gray-600">Create your account</p>
      </div>

      <!-- Signup Form -->
      <div>
        
        {{#if error}}
        <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">
          <p class="text-sm">{{error}}</p>
        </div>
        {{/if}}

        <form method="POST" action="/signup" class="space-y-4">
          
          <!-- Username -->
          <div>
            <label for="username" class="block text-sm font-medium text-gray-700 mb-1">
              Username
            </label>
            <input 
              type="text" 
              id="username" 
              name="username" 
              required
              class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#008080] focus:border-transparent bg-gray-50"
              placeholder="Enter unique username"
            >
          </div>

          <!-- Full Name -->
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">
              Full Name
            </label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required
              class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#008080] focus:border-transparent bg-gray-50"
              placeholder="Enter your full name"
            >
          </div>

          <!-- Role Selection -->
          <div>
            <label for="role" class="block text-sm font-medium text-gray-700 mb-1">
              Role
            </label>
            <select 
              id="role" 
              name="role" 
              required
              class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#008080] focus:border-transparent bg-gray-50"
            >
              <option value="">Select your role</option>
              <option value="receptionist">Receptionist</option>
              <option value="housekeeper">Housekeeper</option>
            </select>
          </div>

          <!-- Password -->
          <div>
            <label for="password" class="block text-sm font-medium text-gray-700 mb-1">
              Password
            </label>
            <input 
              type="password" 
              id="password" 
              name="password" 
              required
              minlength="8"
              class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#008080] focus:border-transparent bg-gray-50"
              placeholder="Minimum 8 characters"
            >
            <p class="mt-1 text-xs text-gray-500">Must be at least 8 characters long</p>
          </div>

          <!-- Confirm Password -->
          <div>
            <label for="confirmPassword" class="block text-sm font-medium text-gray-700 mb-1">
              Confirm Password
            </label>
            <input 
              type="password" 
              id="confirmPassword" 
              name="confirmPassword" 
              required
              class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#008080] focus:border-transparent bg-gray-50"
              placeholder="Re-enter password"
            >
          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <button 
              type="submit"
              class="w-full bg-[#008080] text-white px-6 py-2.5 rounded-lg hover:bg-teal-700 transition font-medium text-sm"
            >
              Create Account
            </button>
          </div>

        </form>

        <!-- Login Link -->
        <div class="mt-6 text-center">
          <p class="text-sm text-gray-600">
            Already have an account? 
            <a href="/login" class="text-[#008080] hover:text-teal-700 font-medium">
              Login here
            </a>
          </p>
        </div>

      </div>
    </div>
  </div>

</body>
</html>
