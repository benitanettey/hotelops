<div class="min-h-screen bg-gray-100">

  <!-- ================= UNIFIED HEADER ================= -->
  <header class="bg-white shadow-sm sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between h-16">
        <!-- Logo and Brand (Far Left) -->
        <div class="flex items-center gap-3">
          <div class="bg-[#008080] text-white p-2 rounded-lg">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4">
              </path>
            </svg>
          </div>
          <h1 class="text-xl font-bold text-gray-800">{{hotelName}}</h1>
        </div>

        <!-- Desktop Navigation Links (Center) - Hidden on mobile -->
        <nav class="hidden md:flex flex-1 justify-center">
          <ul class="flex items-center gap-6">
            <li>
              <a href="/receptionist/dashboard"
                class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Dashboard
              </a>
            </li>
            <li>
              <a href="/receptionist/checkingguests"
                class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Check-In
              </a>
            </li>
            <li>
              <a href="/receptionist/checkoutguests"
                class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Checkout
              </a>
            </li>
            <li>
              <a href="/receptionist/rooms" class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Rooms
              </a>
            </li>
            <li>
              <a href="/receptionist/cleaning-requests"
                class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Cleaning Request
              </a>
            </li>
            <li>
              <a href="/receptionist/housekeepers"
                class="text-sm font-medium text-gray-900 hover:text-[#008080] transition">
                Housekeepers
              </a>
            </li>
          </ul>
        </nav>

        <!-- Right Side Icons (Far Right) - Hidden on mobile -->
        <div class="hidden md:flex items-center gap-4">
          <!-- User Profile - Links to Settings -->
          <a href="/receptionist/settings" class="w-8 h-8 bg-[#008080] rounded-full flex items-center justify-center text-white text-sm font-medium hover:bg-teal-700 transition" title="Settings">
            {{userInitial}}
          </a>

          <!-- Logout Button -->
          <button onclick="showLogoutModal()" class="flex items-center gap-2 text-gray-600 hover:text-red-600 transition" title="Logout">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
            <span class="text-sm font-medium">Logout</span>
          </button>
        </div>

        <!-- Mobile menu button -->
        <button onclick="toggleMobileMenu()" class="md:hidden p-2 rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-100">
          <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Menu (Hidden by default) -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200">
      <div class="px-4 py-3 space-y-1">
        <a href="/receptionist/dashboard" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          Dashboard
        </a>
        <a href="/receptionist/checkingguests" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          Check-In
        </a>
        <a href="/receptionist/checkoutguests" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          Checkout
        </a>
        <a href="/receptionist/rooms" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          Rooms
        </a>
        <a href="/receptionist/cleaning-requests" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          Cleaning Request
        </a>
        <a href="/receptionist/housekeepers" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-900 bg-gray-50">
          Housekeepers
        </a>
        <div class="border-t border-gray-200 my-2 pt-2">
          <button onclick="showLogoutModal()" class="w-full text-left px-3 py-2 rounded-md text-sm font-medium text-red-600 hover:bg-red-50 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
            <span>Logout</span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- ================= PAGE CONTENT ================= -->
  <main class="max-w-7xl mx-auto px-6 py-8">

    <!-- ================= HERO BANNER ================= -->
    <div class="relative rounded-2xl overflow-hidden mb-10 h-[220px]">

      <!-- Parallax Background -->
      <div class="absolute inset-0 bg-fixed bg-center bg-cover"
        style="background-image: url('/images/cleaningsupplies.jpg');">
      </div>

      <!-- Teal Overlay -->
      <div class="absolute inset-0 bg-[#0f766e]/85"></div>

      <!-- Glass Panel -->
      <div class="relative z-10 h-full flex items-center">

        <div class="backdrop-blur-md bg-white/10 border border-white/20 
                rounded-xl px-8 py-6 max-w-xl ml-8
                animate-fadeIn">

          <h3 class="text-2xl font-semibold text-white mb-2">
            Our Dedicated Team
          </h3>

          <p class="text-white/90 text-sm mb-4">
            Professional housekeeping staff committed to excellence.
          </p>

          <!-- Staff Badge -->
          <div class="inline-flex items-center gap-2 bg-white/20 
                  px-4 py-1.5 rounded-full text-white text-xs font-medium">

            <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>

            {{stats.activeToday}} Active Now
          </div>

        </div>

      </div>
    </div>


    <!-- ================= STATS ================= -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">

      <div class="bg-white rounded-xl shadow-sm p-6 text-center">
        <p class="text-3xl font-bold text-gray-800">{{stats.totalStaff}}</p>
        <p class="text-gray-500 text-sm mt-1">Total Staff</p>
      </div>

      <div class="bg-white rounded-xl shadow-sm p-6 text-center">
        <p class="text-3xl font-bold text-green-600">{{stats.activeToday}}</p>
        <p class="text-gray-500 text-sm mt-1">Active Today</p>
      </div>

      <div class="bg-white rounded-xl shadow-sm p-6 text-center">
        <p class="text-3xl font-bold text-blue-600">{{stats.tasksCompletedToday}}</p>
        <p class="text-gray-500 text-sm mt-1">Tasks Completed Today</p>
      </div>

    </div>

    <!-- ================= HOUSEKEEPERS LIST ================= -->
    <div class="bg-white rounded-2xl shadow-sm p-8">

      <h3 class="text-lg font-semibold text-gray-800 mb-6">
        Housekeeping Staff
      </h3>

      {{#if housekeepers.length}}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {{#each housekeepers}}
        <div class="border border-gray-200 rounded-xl p-6 hover:shadow-md transition {{#if this.isActive}}bg-green-50 border-green-200{{/if}}">

          <!-- Header with avatar and status -->
          <div class="flex items-start justify-between mb-4">
            <div class="flex items-center gap-3">
              <div class="w-14 h-14 rounded-full bg-[#0f766e] flex items-center justify-center text-white font-bold text-xl">
                {{substring this.name 0 1}}
              </div>
              <div>
                <p class="font-semibold text-gray-800">{{this.name}}</p>
                <p class="text-xs text-gray-500">@{{this.username}}</p>
              </div>
            </div>
            <span class="flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium rounded-full
              {{#if this.isActive}}
                bg-green-100 text-green-700
              {{else}}
                bg-gray-100 text-gray-500
              {{/if}}">
              <span class="w-2 h-2 rounded-full {{#if this.isActive}}bg-green-500 animate-pulse{{else}}bg-gray-400{{/if}}"></span>
              {{#if this.isActive}}Online{{else}}Offline{{/if}}
            </span>
          </div>

          <!-- Join date -->
          <div class="mb-4 pb-4 border-b border-gray-100">
            <p class="text-xs text-gray-400">Member since</p>
            <p class="text-sm font-medium text-gray-600">{{this.joinDate}}</p>
          </div>

          <!-- Task stats -->
          <div class="space-y-2">
            {{#if this.currentTask}}
            <div class="flex justify-between text-sm bg-blue-50 -mx-2 px-2 py-1.5 rounded-lg">
              <span class="text-blue-600">Currently Cleaning</span>
              <span class="font-semibold text-blue-700">{{this.currentTask}}</span>
            </div>
            {{/if}}
            <div class="flex justify-between text-sm">
              <span class="text-gray-500">Pending Tasks</span>
              <span class="font-semibold {{#if (gt this.taskCount 0)}}text-yellow-600{{else}}text-gray-800{{/if}}">{{this.taskCount}}</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-500">Completed Today</span>
              <span class="font-semibold text-green-600">{{this.completedToday}}</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-500">Total Completed</span>
              <span class="font-semibold text-gray-800">{{this.totalCompleted}}</span>
            </div>
          </div>

        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="text-center py-12">
        <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
        </svg>
        <p class="text-gray-500">No housekeepers registered yet.</p>
        <p class="text-sm text-gray-400 mt-1">Users with "housekeeper" role will appear here.</p>
      </div>
      {{/if}}

    </div>

  </main>

  <!-- Logout Confirmation Modal -->
  <div id="logoutModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center">
    <div class="bg-white rounded-lg shadow-xl p-5 w-72 mx-4">
      <div class="text-center mb-4">
        <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-3">
          <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
        </div>
        <h3 class="text-base font-semibold text-gray-800">Logout?</h3>
      </div>
      <div class="flex gap-3">
        <button onclick="hideLogoutModal()" class="flex-1 bg-gray-200 text-gray-700 px-3 py-2 rounded-lg hover:bg-gray-300 transition font-medium text-sm">
          Cancel
        </button>
        <a href="/logout" class="flex-1 bg-red-600 text-white px-3 py-2 rounded-lg hover:bg-red-700 transition font-medium text-center text-sm">
          Logout
        </a>
      </div>
    </div>
  </div>

  <script>
    function showLogoutModal() {
      document.getElementById('logoutModal').classList.remove('hidden');
    }
    function hideLogoutModal() {
      document.getElementById('logoutModal').classList.add('hidden');
    }
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') hideLogoutModal();
    });

    // Mobile menu toggle
    function toggleMobileMenu() {
      const menu = document.getElementById('mobile-menu');
      const menuIcon = document.getElementById('menu-icon');
      const closeIcon = document.getElementById('close-icon');
      
      menu.classList.toggle('hidden');
      menuIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    }
  </script>

</div>

<!-- ================= ANIMATION STYLES ================= -->
<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(15px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeIn {
    animation: fadeIn 0.8s ease-out forwards;
  }
</style>