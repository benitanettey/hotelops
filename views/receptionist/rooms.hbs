<div class="min-h-screen bg-gray-100">

  <!-- ================= UNIFIED HEADER ================= -->
  <header class="bg-white shadow-sm sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between h-16">
        <!-- Logo and Brand (Far Left) -->
        <div class="flex items-center gap-3">
          <div class="bg-[#008080] text-white p-2 rounded-lg">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4">
              </path>
            </svg>
          </div>
          <h1 class="text-xl font-bold text-gray-800">StaySync</h1>
        </div>

        <!-- Desktop Navigation Links (Center) - Hidden on mobile -->
        <nav class="hidden md:flex flex-1 justify-center">
          <ul class="flex items-center gap-6">
            <li>
              <a href="/receptionist/dashboard"
                class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Dashboard
              </a>
            </li>
            <li>
              <a href="/receptionist/checkingguests"
                class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Check-In
              </a>
            </li>
            <li>
              <a href="/receptionist/checkoutguests"
                class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Checkout
              </a>
            </li>
            <li>
              <a href="/receptionist/rooms" class="text-sm font-medium text-gray-900 hover:text-[#008080] transition">
                Rooms
              </a>
            </li>
            <li>
              <a href="/receptionist/cleaning-requests"
                class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Cleaning Request
              </a>
            </li>
            <li>
              <a href="/receptionist/housekeepers"
                class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Housekeepers
              </a>
            </li>
          </ul>
        </nav>

        <!-- Right Side Icons (Far Right) - Hidden on mobile -->
        <div class="hidden md:flex items-center gap-4">
          <!-- User Profile -->
          <div class="w-8 h-8 bg-[#008080] rounded-full flex items-center justify-center text-white text-sm font-medium">
            R
          </div>

          <!-- Logout Button -->
          <button onclick="showLogoutModal()" class="flex items-center gap-2 text-gray-600 hover:text-red-600 transition" title="Logout">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
            <span class="text-sm font-medium">Logout</span>
          </button>
        </div>

        <!-- Mobile menu button -->
        <button onclick="toggleMobileMenu()" class="md:hidden p-2 rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-100">
          <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Menu (Hidden by default) -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200">
      <div class="px-4 py-3 space-y-1">
        <a href="/receptionist/dashboard" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          Dashboard
        </a>
        <a href="/receptionist/checkingguests" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          Check-In
        </a>
        <a href="/receptionist/checkoutguests" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          Checkout
        </a>
        <a href="/receptionist/rooms" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-900 bg-gray-50">
          Rooms
        </a>
        <a href="/receptionist/cleaning-requests" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          Cleaning Request
        </a>
        <a href="/receptionist/housekeepers" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          Housekeepers
        </a>
        <div class="border-t border-gray-200 my-2 pt-2">
          <button onclick="showLogoutModal()" class="w-full text-left px-3 py-2 rounded-md text-sm font-medium text-red-600 hover:bg-red-50 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
            <span>Logout</span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- ================= PAGE CONTENT ================= -->
  <main class="max-w-7xl mx-auto px-6 py-10 space-y-10">

    <!-- ================= ROOM TYPE BANNERS ================= -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <div class="relative rounded-2xl overflow-hidden shadow-md group">
        <img src="/images/standardroom.jpg"
          class="w-full h-56 object-cover group-hover:scale-105 transition duration-500">
        <div class="absolute inset-0 bg-black/40 flex flex-col justify-end p-6">
          <h3 class="text-white text-xl font-semibold">Standard Rooms</h3>
          <p class="text-gray-200 text-sm">Comfortable and well-equipped</p>
        </div>
      </div>

      <div class="relative rounded-2xl overflow-hidden shadow-md group">
        <img src="/images/premiumroom.jpg"
          class="w-full h-56 object-cover group-hover:scale-105 transition duration-500">
        <div class="absolute inset-0 bg-black/40 flex flex-col justify-end p-6">
          <h3 class="text-white text-xl font-semibold">Premium Suites</h3>
          <p class="text-gray-200 text-sm">Luxury accommodations</p>
        </div>
      </div>

    </div>

    <!-- ================= SUMMARY CARDS ================= -->
    <div class="grid grid-cols-1 sm:grid-cols-5 gap-6">

      <div class="bg-white rounded-xl shadow-sm p-6 text-center border border-teal-600">
        <p class="text-3xl font-bold text-teal-700">{{totalRooms}}</p>
        <p class="text-gray-500 text-sm mt-1">All Rooms</p>
      </div>

      <div class="bg-white rounded-xl shadow-sm p-6 text-center">
        <p class="text-3xl font-bold text-green-600">{{availableRooms}}</p>
        <p class="text-gray-500 text-sm mt-1">Available</p>
      </div>

      <div class="bg-white rounded-xl shadow-sm p-6 text-center">
        <p class="text-3xl font-bold text-blue-600">{{occupiedRooms}}</p>
        <p class="text-gray-500 text-sm mt-1">Occupied</p>
      </div>

      <div class="bg-white rounded-xl shadow-sm p-6 text-center">
        <p class="text-3xl font-bold text-orange-500">{{cleaningRooms}}</p>
        <p class="text-gray-500 text-sm mt-1">Cleaning</p>
      </div>

      <div class="bg-white rounded-xl shadow-sm p-6 text-center">
        <p class="text-3xl font-bold text-red-500">{{maintenanceRooms}}</p>
        <p class="text-gray-500 text-sm mt-1">Maintenance</p>
      </div>

    </div>

    <!-- ================= ROOMS TABLE ================= -->
    <div class="bg-white rounded-2xl shadow-sm p-8">

      <div class="flex justify-between items-center mb-6">
        <h3 class="text-lg font-semibold text-gray-800">Room List</h3>
        <input type="text" placeholder="Search rooms..."
          class="border border-gray-300 rounded-lg px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#0f766e] focus:border-transparent">
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-gray-500 border-b">
              <th class="py-3">Room Number</th>
              <th>Type</th>
              <th>Floor</th>
              <th>Status</th>
              <th>Guest</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-gray-100">

            {{#each rooms}}
            <tr class="hover:bg-gray-50 transition">
              <td class="py-4 font-medium text-gray-800">{{roomNumber}}</td>
              <td>{{type}}</td>
              <td>{{floor}}</td>

              <td>
                {{#if (eq status "Available")}}
                <span class="px-3 py-1 rounded-full text-xs bg-green-100 text-green-700">Available</span>
                {{/if}}

                {{#if (eq status "Occupied")}}
                <span class="px-3 py-1 rounded-full text-xs bg-blue-100 text-blue-700">Occupied</span>
                {{/if}}

                {{#if (eq status "Cleaning")}}
                <span class="px-3 py-1 rounded-full text-xs bg-orange-100 text-orange-700">Cleaning</span>
                {{/if}}

                {{#if (eq status "Maintenance")}}
                <span class="px-3 py-1 rounded-full text-xs bg-red-100 text-red-700">Maintenance</span>
                {{/if}}
              </td>

              <td>
                {{#if guest}}
                {{guest}}
                {{else}}
                -
                {{/if}}
              </td>

              <td>
                {{#if (eq status "Cleaning")}}
                <button class="bg-[#0f766e] text-white px-4 py-1 rounded-lg text-xs hover:bg-teal-700 transition">
                  Mark Cleaned
                </button>
                {{else}}
                -
                {{/if}}
              </td>
            </tr>
            {{/each}}

          </tbody>
        </table>
      </div>

    </div>

  </main>

  <!-- Logout Confirmation Modal -->
  <div id="logoutModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center">
    <div class="bg-white rounded-lg shadow-xl p-5 w-72 mx-4">
      <div class="text-center mb-4">
        <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-3">
          <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
        </div>
        <h3 class="text-base font-semibold text-gray-800">Logout?</h3>
      </div>
      <div class="flex gap-3">
        <button onclick="hideLogoutModal()" class="flex-1 bg-gray-200 text-gray-700 px-3 py-2 rounded-lg hover:bg-gray-300 transition font-medium text-sm">
          Cancel
        </button>
        <a href="/logout" class="flex-1 bg-red-600 text-white px-3 py-2 rounded-lg hover:bg-red-700 transition font-medium text-center text-sm">
          Logout
        </a>
      </div>
    </div>
  </div>

  <script>
    function showLogoutModal() {
      document.getElementById('logoutModal').classList.remove('hidden');
    }
    function hideLogoutModal() {
      document.getElementById('logoutModal').classList.add('hidden');
    }
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') hideLogoutModal();
    });

    // Mobile menu toggle
    function toggleMobileMenu() {
      const menu = document.getElementById('mobile-menu');
      const menuIcon = document.getElementById('menu-icon');
      const closeIcon = document.getElementById('close-icon');
      
      menu.classList.toggle('hidden');
      menuIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    }
  </script>

</div>