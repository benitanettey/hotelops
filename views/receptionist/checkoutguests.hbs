<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(25px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeInUp {
    animation: fadeInUp 0.8s ease-out forwards;
  }
</style>

<div class="min-h-screen bg-gray-100">

  <!-- ================= UNIFIED HEADER ================= -->
  <header class="bg-white shadow-sm sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between h-16">
        <!-- Logo and Brand (Far Left) -->
        <div class="flex items-center gap-3">
          <div class="bg-[#008080] text-white p-2 rounded-lg">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4">
              </path>
            </svg>
          </div>
          <h1 class="text-xl font-bold text-gray-800">{{hotelName}}</h1>
        </div>

        <!-- Desktop Navigation Links (Center) - Hidden on mobile -->
        <nav class="hidden md:flex flex-1 justify-center">
          <ul class="flex items-center gap-6">
            <li>
              <a href="/receptionist/dashboard"
                class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Dashboard
              </a>
            </li>
            <li>
              <a href="/receptionist/checkingguests"
                class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Check-In
              </a>
            </li>
            <li>
              <a href="/receptionist/checkoutguests"
                class="text-sm font-medium text-gray-900 hover:text-[#008080] transition">
                Checkout
              </a>
            </li>
            <li>
              <a href="/receptionist/rooms" class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Rooms
              </a>
            </li>
            <li>
              <a href="/receptionist/cleaning-requests"
                class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Cleaning Request
              </a>
            </li>
            <li>
              <a href="/receptionist/housekeepers"
                class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Housekeepers
              </a>
            </li>
          </ul>
        </nav>

        <!-- Right Side Icons (Far Right) - Hidden on mobile -->
        <div class="hidden md:flex items-center gap-4">
          <!-- User Profile - Links to Settings -->
          <a href="/receptionist/settings" class="w-8 h-8 bg-[#008080] rounded-full flex items-center justify-center text-white text-sm font-medium hover:bg-teal-700 transition" title="Settings">
            {{userInitial}}
          </a>

          <!-- Logout Button -->
          <button onclick="showLogoutModal()" class="flex items-center gap-2 text-gray-600 hover:text-red-600 transition" title="Logout">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
            <span class="text-sm font-medium">Logout</span>
          </button>
        </div>

        <!-- Mobile menu button -->
        <button onclick="toggleMobileMenu()" class="md:hidden p-2 rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-100">
          <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Menu (Hidden by default) -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200">
      <div class="px-4 py-3 space-y-1">
        <a href="/receptionist/dashboard" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          Dashboard
        </a>
        <a href="/receptionist/checkingguests" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          Check-In
        </a>
        <a href="/receptionist/checkoutguests" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-900 bg-gray-50">
          Checkout
        </a>
        <a href="/receptionist/rooms" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          Rooms
        </a>
        <a href="/receptionist/cleaning-requests" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          Cleaning Request
        </a>
        <a href="/receptionist/housekeepers" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          Housekeepers
        </a>
        <div class="border-t border-gray-200 my-2 pt-2">
          <button onclick="showLogoutModal()" class="w-full text-left px-3 py-2 rounded-md text-sm font-medium text-red-600 hover:bg-red-50 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
            <span>Logout</span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- ================= MAIN ================= -->
  <main class="max-w-7xl mx-auto px-6 py-10 animate-fadeInUp">

    <!-- ================= HERO ================= -->
    <section class="relative rounded-2xl overflow-hidden h-[180px] shadow-md mb-10">

      <div class="absolute inset-0 bg-gradient-to-r from-[#0f766e] via-[#14b8a6] to-[#0f766e]/60"></div>

      <div class="relative z-10 h-full flex items-center">

        <div class="ml-10 backdrop-blur-md bg-white/10 
                    border border-white/20 
                    rounded-xl px-8 py-6 
                    shadow-lg">

          <h3 class="text-2xl font-bold text-white mb-2">
            Seamless Departures
          </h3>

          <p class="text-white/90 text-sm">
            Ensure a smooth experience until the very end
          </p>

        </div>

      </div>

    </section>

    <!-- ================= OCCUPIED ROOMS ================= -->
    <section class="bg-white rounded-2xl shadow-sm overflow-hidden">

      <div class="p-6 border-b border-gray-200">

        <div class="flex items-center justify-between mb-4">
          <div>
            <h3 class="text-xl font-semibold text-gray-800">Occupied Rooms</h3>
            <p class="text-sm text-gray-600 mt-1">Guests currently checked in</p>
          </div>

          <div class="relative">
            <input type="text" id="searchInput" placeholder="Search guest or room..."
              class="pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f766e] focus:border-transparent">
            <svg class="w-5 h-5 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor"
              viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
        </div>

        {{#if error}}
        <div class="p-4 bg-red-50 border border-red-200 rounded-lg flex items-center gap-3">
          <svg class="w-5 h-5 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <p class="text-sm text-red-700">{{error}}</p>
        </div>
        {{/if}}

        {{#if success}}
        <div class="p-4 bg-green-50 border border-green-200 rounded-lg flex items-center gap-3">
          <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <p class="text-sm text-green-700">{{success}}</p>
        </div>
        {{/if}}

      </div>

      <!-- GUEST CARDS -->
      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="guestCardsContainer">
          {{#each occupiedRooms}}
          <div class="border border-gray-200 rounded-xl overflow-hidden hover:border-[#008080] hover:shadow-md transition guest-card" 
               data-guest-name="{{guestName}}" 
               data-room-number="{{roomNumber}}"
               data-all-guests='{{allGuestsJSON}}'>
            <!-- Card Header -->
            <div class="bg-gray-50 px-4 py-3 flex items-center justify-between border-b border-gray-100">
              <div class="flex items-center gap-3">
                <span class="bg-[#008080] text-white text-sm font-bold px-3 py-1 rounded-lg">{{roomNumber}}</span>
                <span class="text-sm text-gray-500 capitalize">{{roomType}}</span>
              </div>
              {{#if isLate}}
              <span class="text-xs bg-red-100 text-red-700 px-2 py-1 rounded-full">Overdue</span>
              {{/if}}
              {{#if isEarly}}
              <span class="text-xs bg-blue-100 text-blue-700 px-2 py-1 rounded-full">Early</span>
              {{/if}}
            </div>
            
            <!-- Card Body - Clickable for guest details -->
            <div class="p-4 space-y-3 cursor-pointer" onclick="showGuestDetails(this.closest('.guest-card'))">
              <!-- Guest Info -->
              <div>
                <p class="font-semibold text-gray-800 truncate" title="{{guestDisplayName}}">{{guestDisplayName}}</p>
                <p class="text-xs text-gray-500">{{totalGuests}} guest(s) - Click to view details</p>
              </div>
              
              <!-- Stay Info -->
              <div class="grid grid-cols-2 gap-2 text-sm">
                <div class="bg-gray-50 rounded-lg p-2">
                  <p class="text-xs text-gray-500">Check-in</p>
                  <p class="font-medium text-gray-700">{{checkInDate}}</p>
                </div>
                <div class="bg-gray-50 rounded-lg p-2">
                  <p class="text-xs text-gray-500">Expected out</p>
                  <p class="font-medium text-gray-700">{{expectedCheckOutDate}}</p>
                </div>
              </div>
              
              <!-- Pricing -->
              <div class="border-t border-gray-100 pt-3">
                <div class="flex items-center justify-between text-sm mb-1">
                  <span class="text-gray-500">${{pricePerNight}} × {{actualNights}} night(s)</span>
                  <span class="font-semibold text-[#008080]">${{actualAmount}}</span>
                </div>
                {{#if isLate}}
                <p class="text-xs text-red-600">Originally booked {{expectedNights}} nights (${{expectedAmount}})</p>
                {{/if}}
                {{#if isEarly}}
                <p class="text-xs text-blue-600">Checking out {{expectedNights}} night(s) early</p>
                {{/if}}
                <p class="text-xs text-gray-400 mt-1">Minimum amount due</p>
              </div>
            </div>
            
            <!-- Card Footer -->
            <div class="px-4 py-3 bg-gray-50 border-t border-gray-100">
              <form method="POST" action="/receptionist/checkout">
                <input type="hidden" name="guestId" value="{{guestId}}">
                <input type="hidden" name="roomNumber" value="{{roomNumber}}">
                <button type="submit"
                  class="w-full bg-[#008080] text-white px-4 py-2 rounded-lg hover:bg-teal-700 transition inline-flex items-center justify-center gap-2 text-sm font-medium">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1">
                    </path>
                  </svg>
                  Process Checkout
                </button>
              </form>
            </div>
          </div>
          {{else}}
          <div class="col-span-full py-12 text-center">
            <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
            <h4 class="text-lg font-medium text-gray-900 mb-1">No Occupied Rooms</h4>
            <p class="text-sm text-gray-500">All rooms are currently available</p>
          </div>
          {{/each}}
        </div>
      </div>

    </section>
  </main>

  <!-- Logout Confirmation Modal -->
  <div id="logoutModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center">
    <div class="bg-white rounded-lg shadow-xl p-5 w-72 mx-4">
      <div class="text-center mb-4">
        <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-3">
          <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
        </div>
        <h3 class="text-base font-semibold text-gray-800">Logout?</h3>
      </div>
      <div class="flex gap-3">
        <button onclick="hideLogoutModal()" class="flex-1 bg-gray-200 text-gray-700 px-3 py-2 rounded-lg hover:bg-gray-300 transition font-medium text-sm">
          Cancel
        </button>
        <a href="/logout" class="flex-1 bg-red-600 text-white px-3 py-2 rounded-lg hover:bg-red-700 transition font-medium text-center text-sm">
          Logout
        </a>
      </div>
    </div>
  </div>

  <!-- Guest Details Modal -->
  <div id="guestDetailsModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full mx-4 max-h-[80vh] overflow-hidden">
      <div class="bg-[#008080] text-white px-5 py-4 flex items-center justify-between">
        <h3 class="text-lg font-semibold">Guest Details</h3>
        <button onclick="hideGuestDetailsModal()" class="text-white/80 hover:text-white">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div id="guestDetailsContent" class="p-5 overflow-y-auto max-h-[60vh] space-y-4">
        <!-- Content will be populated by JavaScript -->
      </div>
      <div class="px-5 py-3 bg-gray-50 border-t">
        <button onclick="hideGuestDetailsModal()" class="w-full bg-gray-200 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-300 transition font-medium text-sm">
          Close
        </button>
      </div>
    </div>
  </div>

  <script>
    function showLogoutModal() {
      document.getElementById('logoutModal').classList.remove('hidden');
    }
    function hideLogoutModal() {
      document.getElementById('logoutModal').classList.add('hidden');
    }
    
    // Guest details modal
    function showGuestDetails(card) {
      const allGuests = JSON.parse(card.dataset.allGuests || '[]');
      const roomNumber = card.dataset.roomNumber;
      
      const content = document.getElementById('guestDetailsContent');
      
      if (allGuests.length === 0) {
        content.innerHTML = '<p class="text-gray-500 text-center">No guest information available</p>';
      } else {
        content.innerHTML = allGuests.map((guest, index) => `
          <div class="border border-gray-200 rounded-lg p-4 ${guest.isPrimary ? 'bg-teal-50 border-teal-200' : ''}">
            <div class="flex items-center gap-2 mb-3">
              <span class="${guest.isPrimary ? 'bg-[#008080] text-white' : 'bg-gray-200 text-gray-700'} text-xs px-2 py-1 rounded font-medium">
                ${guest.isPrimary ? 'Primary Guest' : (guest.isAdult ? 'Adult' : 'Child')}
              </span>
              ${index === 0 ? '<span class="text-xs text-gray-500">Room ' + roomNumber + '</span>' : ''}
            </div>
            <h4 class="font-semibold text-gray-800 mb-2">${guest.fullName || 'Unknown'}</h4>
            <div class="space-y-1 text-sm">
              ${guest.email ? '<p class="text-gray-600"><span class="text-gray-400">Email:</span> ' + guest.email + '</p>' : ''}
              ${guest.phone ? '<p class="text-gray-600"><span class="text-gray-400">Phone:</span> ' + guest.phone + '</p>' : ''}
              ${guest.idNumber ? '<p class="text-gray-600"><span class="text-gray-400">ID:</span> ' + guest.idNumber + '</p>' : ''}
              ${!guest.email && !guest.phone && !guest.idNumber ? '<p class="text-gray-400 italic">No additional details</p>' : ''}
            </div>
          </div>
        `).join('');
      }
      
      document.getElementById('guestDetailsModal').classList.remove('hidden');
    }
    
    function hideGuestDetailsModal() {
      document.getElementById('guestDetailsModal').classList.add('hidden');
    }
    
    // Search functionality
    document.getElementById('searchInput').addEventListener('input', function(e) {
      const searchTerm = e.target.value.toLowerCase();
      const cards = document.querySelectorAll('.guest-card');
      
      cards.forEach(card => {
        const guestName = (card.dataset.guestName || '').toLowerCase();
        const roomNumber = (card.dataset.roomNumber || '').toLowerCase();
        
        if (guestName.includes(searchTerm) || roomNumber.includes(searchTerm)) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
    
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        hideLogoutModal();
        hideGuestDetailsModal();
      }
    });

    // Mobile menu toggle
    function toggleMobileMenu() {
      const menu = document.getElementById('mobile-menu');
      const menuIcon = document.getElementById('menu-icon');
      const closeIcon = document.getElementById('close-icon');
      
      menu.classList.toggle('hidden');
      menuIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    }
  </script>

</div>