<!-- 
  GUEST CHECKOUT PAGE
  This page displays all currently checked-in guests and allows receptionist to process checkouts.
  
  BACKEND TODO:
  - Pass occupiedRooms array from controller with guest and room details
  - Each occupiedRooms item should contain:
    * roomNumber
    * guestName
    * roomType (Single, Double, Suite, etc.)
    * checkInDate
    * expectedCheckOutDate
    * amountDue
    * guestId
  - Handle POST request to /receptionist/checkout/:guestId
  - Update room status from 'Occupied' to 'Needs Cleaning' 
  - Update guest record with actual checkout date
  - Create cleaning task for the room in cleaningTasks.json
  - Calculate and process final amount (if payment processing is added later)
  - Redirect back to checkout page or dashboard with success message
  
  SEARCH FUNCTIONALITY TODO:
  - Implement client-side or server-side search to filter table by guest name or room number
-->

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(25px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeInUp {
    animation: fadeInUp 0.8s ease-out forwards;
  }
</style>

<div class="min-h-screen bg-gray-100">

  <!-- ================= TOP HEADER ================= -->
  <header class="bg-[#0f766e] shadow-sm">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex items-center justify-between h-16">

        <div class="flex items-center gap-3">
          <div class="bg-white/20 p-2 rounded-lg">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <div>
            <h1 class="text-white font-semibold text-lg">StaySync</h1>
            <p class="text-white/80 text-xs">Receptionist Portal</p>
          </div>
        </div>

        <div class="w-28 h-9 bg-white/30 rounded-lg"></div>
      </div>
    </div>
  </header>

  <!-- ================= SECONDARY NAV ================= -->
  <nav class="bg-white border-b">
    <div class="max-w-7xl mx-auto px-6">
      <ul class="flex items-center gap-8 text-sm font-medium text-gray-600 h-12">

        <li>
          <a href="/receptionist/dashboard"
            class="{{#if (eq title 'Dashboard')}}text-[#0f766e] border-b-2 border-[#0f766e] pb-2{{else}}hover:text-[#0f766e]{{/if}}">
            Dashboard
          </a>
        </li>

        <li>
          <a href="/receptionist/checkingguests"
            class="{{#if (eq title 'Check-In')}}text-[#0f766e] border-b-2 border-[#0f766e] pb-2{{else}}hover:text-[#0f766e]{{/if}}">
            Check-In
          </a>
        </li>

        <li>
          <a href="/receptionist/checkoutguests" class="text-[#0f766e] border-b-2 border-[#0f766e] pb-2">
            Checkout
          </a>
        </li>

        <li>
          <a href="/receptionist/rooms"
            class="{{#if (eq title 'Room Management')}}text-[#0f766e] border-b-2 border-[#0f766e] pb-2{{else}}hover:text-[#0f766e]{{/if}}">
            Rooms
          </a>
        </li>

        <li>
          <a href="/receptionist/cleaning-requests"
            class="{{#if (eq title 'Cleaning Requests')}}text-[#0f766e] border-b-2 border-[#0f766e] pb-2{{else}}hover:text-[#0f766e]{{/if}}">
            Cleaning Requests
          </a>
        </li>

        <li>
          <a href="/receptionist/housekeepers"
            class="{{#if (eq title 'Housekeepers')}}text-[#0f766e] border-b-2 border-[#0f766e] pb-2{{else}}hover:text-[#0f766e]{{/if}}">
            Housekeepers
          </a>
        </li>

      </ul>
    </div>
  </nav>

  <!-- ================= MAIN ================= -->
  <main class="max-w-7xl mx-auto px-6 py-10 animate-fadeInUp">

    <!-- ================= HERO ================= -->
    <section class="relative rounded-2xl overflow-hidden h-[180px] shadow-md mb-10">

      <div class="absolute inset-0 bg-gradient-to-r from-[#0f766e] via-[#14b8a6] to-[#0f766e]/60"></div>

      <div class="relative z-10 h-full flex items-center">

        <div class="ml-10 backdrop-blur-md bg-white/10 
                    border border-white/20 
                    rounded-xl px-8 py-6 
                    shadow-lg">

          <h3 class="text-2xl font-bold text-white mb-2">
            Seamless Departures
          </h3>

          <p class="text-white/90 text-sm">
            Ensure a smooth experience until the very end
          </p>

        </div>

      </div>

    </section>

    <!-- ================= OCCUPIED ROOMS ================= -->
    <section class="bg-white rounded-2xl shadow-sm overflow-hidden">

      <div class="p-6 border-b border-gray-200 flex items-center justify-between">

        <div>
          <h3 class="text-xl font-semibold text-gray-800">Occupied Rooms</h3>
          <p class="text-sm text-gray-600 mt-1">Guests currently checked in</p>
        </div>

        <div class="relative">
          <input type="text" id="searchInput" placeholder="Search guest or room..."
            class="pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f766e] focus:border-transparent">
          <svg class="w-5 h-5 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor"
            viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>

      </div>

      <!-- TABLE (unchanged structure) -->
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Room</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Guest Name</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Check-In</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Expected
                Check-Out</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
            </tr>
          </thead>

          <tbody class="bg-white divide-y divide-gray-200">
            <!-- Loop through occupiedRooms array -->
            {{#each occupiedRooms}}
            <tr class="hover:bg-gray-50 transition">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                {{this.roomNumber}}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                {{this.guestName}}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                {{this.roomType}}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                {{this.checkInDate}}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                {{this.expectedCheckOutDate}}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <form method="POST" action="/receptionist/checkout" class="inline">
                  <input type="hidden" name="guestId" value="{{this.guestId}}">
                  <input type="hidden" name="roomNumber" value="{{this.roomNumber}}">
                  <button type="submit"
                    class="bg-[#008080] text-white px-4 py-2 rounded-lg hover:bg-teal-700 transition inline-flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1">
                      </path>
                    </svg>
                    Checkout
                  </button>
                </form>
              </td>
            </tr>
            {{/each}}

            {{#unless occupiedRooms.length}}
            <tr>
              <td colspan="6" class="px-6 py-12 text-center">
                <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                </svg>
                <h4 class="text-lg font-medium text-gray-900 mb-1">No Occupied Rooms</h4>
                <p class="text-sm text-gray-500">All rooms are currently available</p>
              </td>
            </tr>
            {{/unless}}
          </tbody>
        </table>
      </div>

    </section>

  </main>
</div>