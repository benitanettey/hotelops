<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(25px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeInUp {
    animation: fadeInUp 0.8s ease-out forwards;
  }
</style>

<div class="min-h-screen bg-gray-100">

  <!-- ================= UNIFIED HEADER ================= -->
  <header class="bg-white shadow-sm sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between h-16">
        <!-- Logo and Brand (Far Left) -->
        <div class="flex items-center gap-3">
          <div class="bg-[#008080] text-white p-2 rounded-lg">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4">
              </path>
            </svg>
          </div>
          <h1 class="text-xl font-bold text-gray-800">{{hotelName}}</h1>
        </div>

        <!-- Desktop Navigation Links (Center) - Hidden on mobile -->
        <nav class="hidden md:flex flex-1 justify-center">
          <ul class="flex items-center gap-6">
            <li>
              <a href="/receptionist/dashboard"
                class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Dashboard
              </a>
            </li>
            <li>
              <a href="/receptionist/checkingguests"
                class="text-sm font-medium text-gray-900 hover:text-[#008080] transition">
                Check-In
              </a>
            </li>
            <li>
              <a href="/receptionist/checkoutguests"
                class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Checkout
              </a>
            </li>
            <li>
              <a href="/receptionist/rooms" class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Rooms
              </a>
            </li>
            <li>
              <a href="/receptionist/cleaning-requests"
                class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Cleaning Request
              </a>
            </li>
            <li>
              <a href="/receptionist/housekeepers"
                class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Housekeepers
              </a>
            </li>
          </ul>
        </nav>

        <!-- Right Side Icons (Far Right) - Hidden on mobile -->
        <div class="hidden md:flex items-center gap-4">
          <!-- User Profile - Links to Settings -->
          <a href="/receptionist/settings" class="w-8 h-8 bg-[#008080] rounded-full flex items-center justify-center text-white text-sm font-medium hover:bg-teal-700 transition" title="Settings">
            {{userInitial}}
          </a>

          <!-- Logout Button -->
          <button onclick="showLogoutModal()" class="flex items-center gap-2 text-gray-600 hover:text-red-600 transition" title="Logout">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
            <span class="text-sm font-medium">Logout</span>
          </button>
        </div>

        <!-- Mobile menu button -->
        <button onclick="toggleMobileMenu()" class="md:hidden p-2 rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-100">
          <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Menu (Hidden by default) -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200">
      <div class="px-4 py-3 space-y-1">
        <a href="/receptionist/dashboard" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          Dashboard
        </a>
        <a href="/receptionist/checkingguests" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-900 bg-gray-50">
          Check-In
        </a>
        <a href="/receptionist/checkoutguests" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          Checkout
        </a>
        <a href="/receptionist/rooms" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          Rooms
        </a>
        <a href="/receptionist/cleaning-requests" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          Cleaning Request
        </a>
        <a href="/receptionist/housekeepers" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          Housekeepers
        </a>
        <div class="border-t border-gray-200 my-2 pt-2">
          <button onclick="showLogoutModal()" class="w-full text-left px-3 py-2 rounded-md text-sm font-medium text-red-600 hover:bg-red-50 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
            <span>Logout</span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- ================= MAIN ================= -->
  <main class="max-w-7xl mx-auto px-6 py-8 space-y-8 animate-fadeInUp">

    <!-- ================= COMPACT HERO ================= -->
    <section class="relative rounded-xl overflow-hidden h-[120px] shadow-md">
      <div class="absolute inset-0 bg-gradient-to-r from-[#0f766e] via-[#14b8a6] to-[#0f766e]/80"></div>
      <div class="relative z-10 h-full flex items-center justify-between px-8">
        <div>
          <h3 class="text-xl font-bold text-white">Guest Check-In</h3>
          <p class="text-white/80 text-sm">Register new guests and assign rooms</p>
        </div>
        <div class="bg-white/20 backdrop-blur-sm rounded-lg px-4 py-2 border border-white/30">
          <p class="text-white text-sm font-medium">{{totalAvailable}} rooms available</p>
        </div>
      </div>
    </section>

    {{#if error}}
    <div class="p-4 bg-red-50 border border-red-200 rounded-lg flex items-center gap-3">
      <svg class="w-5 h-5 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <p class="text-sm text-red-700">{{error}}</p>
    </div>
    {{/if}}

    {{#if success}}
    <div class="p-4 bg-green-50 border border-green-200 rounded-lg flex items-center gap-3">
      <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <p class="text-sm text-green-700">{{success}}</p>
    </div>
    {{/if}}

    <!-- ================= TWO COLUMN LAYOUT ================= -->
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-8">

      <!-- LEFT: ROOM SELECTION -->
      <section class="bg-white rounded-xl shadow-sm overflow-hidden">
        <div class="p-6 border-b border-gray-100">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-800">Select Room</h3>
            <!-- Search -->
            <div class="relative">
              <input type="text" id="roomSearch" placeholder="Search rooms..."
                class="pl-9 pr-4 py-2 text-sm border border-gray-200 rounded-lg focus:ring-2 focus:ring-[#0f766e] focus:border-transparent w-48">
              <svg class="w-4 h-4 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
          </div>

          <!-- Room Type Filter Tabs -->
          <div class="flex flex-wrap gap-2" id="roomTypeTabs">
            <button type="button" data-type="all" class="room-type-tab active px-4 py-2 text-sm font-medium rounded-lg bg-[#0f766e] text-white transition">
              All ({{totalAvailable}})
            </button>
            {{#each roomTypeStats}}
            <button type="button" data-type="{{name}}" class="room-type-tab px-4 py-2 text-sm font-medium rounded-lg bg-gray-100 text-gray-600 hover:bg-gray-200 transition capitalize">
              {{name}} ({{count}})
            </button>
            {{/each}}
          </div>
        </div>

        <!-- Room Grid -->
        <div class="p-6">
          <div id="roomGrid" class="grid grid-cols-2 sm:grid-cols-3 gap-3 max-h-[400px] overflow-y-auto">
            <!-- Rooms will be rendered by JavaScript -->
          </div>

          <!-- Pagination Info -->
          <div id="paginationInfo" class="mt-4 flex items-center justify-between text-sm text-gray-500">
            <span id="showingInfo">Showing 0 rooms</span>
            <button type="button" id="loadMoreBtn" class="hidden text-[#0f766e] hover:text-teal-700 font-medium">
              Load more
            </button>
          </div>

          <!-- No rooms message -->
          <div id="noRoomsMessage" class="hidden text-center py-8">
            <svg class="w-12 h-12 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
            <p class="text-gray-500">No rooms match your criteria</p>
          </div>
        </div>

        <!-- Selected Room Summary -->
        <div id="selectedRoomSummary" class="hidden border-t border-gray-100 p-4 bg-teal-50">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm text-gray-600">Selected Room</p>
              <p class="font-semibold text-[#0f766e]" id="selectedRoomDisplay">-</p>
            </div>
            <button type="button" onclick="clearRoomSelection()" class="text-sm text-gray-500 hover:text-red-500">
              Clear
            </button>
          </div>
        </div>
      </section>

      <!-- RIGHT: GUEST FORM -->
      <section class="bg-white rounded-xl shadow-sm p-6">
        <h3 class="text-lg font-semibold text-gray-800 mb-6">Guest Information</h3>

        <form method="POST" action="/receptionist/checkin" id="checkinForm" class="space-y-5">
          <!-- Hidden field for selected room -->
          <input type="hidden" id="roomSelect" name="roomSelect" required>
          <!-- Hidden field for additional guests -->
          <input type="hidden" id="additionalGuests" name="additionalGuests" value="[]">

          <!-- Primary Guest Label -->
          <div class="flex items-center gap-2 pb-2 border-b border-gray-100">
            <span class="bg-[#0f766e] text-white text-xs px-2 py-1 rounded">Primary</span>
            <span class="text-sm text-gray-600">Lead guest (must be 18+)</span>
          </div>

          <!-- Name Fields -->
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="firstName" class="block text-sm font-medium text-gray-700 mb-1">First Name</label>
              <input type="text" id="firstName" name="firstName" required
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f766e] focus:border-transparent text-sm">
            </div>
            <div>
              <label for="lastName" class="block text-sm font-medium text-gray-700 mb-1">Last Name</label>
              <input type="text" id="lastName" name="lastName" required
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f766e] focus:border-transparent text-sm">
            </div>
          </div>

          <!-- Contact Fields -->
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
              <input type="email" id="email" name="email" required
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f766e] focus:border-transparent text-sm">
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Phone</label>
              <input type="tel" id="phone" name="phone" required
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f766e] focus:border-transparent text-sm">
            </div>
          </div>

          <!-- ID Number -->
          <div>
            <label for="idNumber" class="block text-sm font-medium text-gray-700 mb-1">ID/Passport Number</label>
            <input type="text" id="idNumber" name="idNumber" required
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f766e] focus:border-transparent text-sm">
          </div>

          <!-- Date Fields -->
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="checkInDate" class="block text-sm font-medium text-gray-700 mb-1">Check-In</label>
              <input type="date" id="checkInDate" name="checkInDate" required
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f766e] focus:border-transparent text-sm">
            </div>
            <div>
              <label for="checkOutDate" class="block text-sm font-medium text-gray-700 mb-1">Check-Out</label>
              <input type="date" id="checkOutDate" name="checkOutDate" required
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f766e] focus:border-transparent text-sm">
            </div>
          </div>

          <!-- Stay Duration & Estimate -->
          <div id="stayEstimate" class="hidden p-3 bg-gray-50 rounded-lg">
            <div class="flex items-center justify-between text-sm">
              <span class="text-gray-600">Est. stay: <span id="nightsCount" class="font-medium">0</span> night(s)</span>
              <span class="text-[#0f766e] font-semibold">~$<span id="estimatedCost">0</span></span>
            </div>
          </div>

          <!-- Additional Guests Section -->
          <div class="border-t border-gray-100 pt-4">
            <div class="flex items-center justify-between mb-3">
              <div>
                <h4 class="text-sm font-medium text-gray-700">Additional Guests</h4>
                <p class="text-xs text-gray-500">Add other guests staying in this room</p>
              </div>
              <button type="button" onclick="addGuest()" class="text-sm text-[#0f766e] hover:text-teal-700 font-medium flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
                Add Guest
              </button>
            </div>
            <div id="additionalGuestsList" class="space-y-3">
              <!-- Additional guests will be added here -->
            </div>
            <div id="guestSummary" class="hidden mt-3 text-sm text-gray-600 bg-gray-50 rounded-lg p-3">
              <span id="adultCount">1</span> adult(s), <span id="childCount">0</span> child(ren)
            </div>
          </div>

          <!-- Submit -->
          <button type="submit" id="submitBtn" disabled
            class="w-full bg-gray-300 text-gray-500 px-6 py-3 rounded-lg font-medium cursor-not-allowed transition">
            Select a room to continue
          </button>
        </form>
      </section>

    </div>
  </main>

  <!-- Logout Confirmation Modal -->
  <div id="logoutModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center">
    <div class="bg-white rounded-lg shadow-xl p-5 w-72 mx-4">
      <div class="text-center mb-4">
        <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-3">
          <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
        </div>
        <h3 class="text-base font-semibold text-gray-800">Logout?</h3>
      </div>
      <div class="flex gap-3">
        <button onclick="hideLogoutModal()" class="flex-1 bg-gray-200 text-gray-700 px-3 py-2 rounded-lg hover:bg-gray-300 transition font-medium text-sm">
          Cancel
        </button>
        <a href="/logout" class="flex-1 bg-red-600 text-white px-3 py-2 rounded-lg hover:bg-red-700 transition font-medium text-center text-sm">
          Logout
        </a>
      </div>
    </div>
  </div>

  <script>
    // Room data from server
    const allRooms = {{{availableRoomsJSON}}};
    let filteredRooms = [...allRooms];
    let displayedCount = 12;
    let selectedRoom = null;
    let additionalGuests = [];
    let guestIdCounter = 0;

    // DOM Elements
    const roomGrid = document.getElementById('roomGrid');
    const roomSearch = document.getElementById('roomSearch');
    const showingInfo = document.getElementById('showingInfo');
    const loadMoreBtn = document.getElementById('loadMoreBtn');
    const noRoomsMessage = document.getElementById('noRoomsMessage');
    const selectedRoomSummary = document.getElementById('selectedRoomSummary');
    const selectedRoomDisplay = document.getElementById('selectedRoomDisplay');
    const roomSelectInput = document.getElementById('roomSelect');
    const submitBtn = document.getElementById('submitBtn');

    // Initialize
    document.addEventListener('DOMContentLoaded', function() {
      renderRooms();
      setupEventListeners();
      setDefaultDates();
    });

    function setDefaultDates() {
      const today = new Date().toISOString().split('T')[0];
      document.getElementById('checkInDate').value = today;
      document.getElementById('checkInDate').min = today;
      document.getElementById('checkOutDate').min = today;
    }

    function setupEventListeners() {
      // Room type tabs
      document.querySelectorAll('.room-type-tab').forEach(tab => {
        tab.addEventListener('click', function() {
          document.querySelectorAll('.room-type-tab').forEach(t => {
            t.classList.remove('bg-[#0f766e]', 'text-white');
            t.classList.add('bg-gray-100', 'text-gray-600');
          });
          this.classList.remove('bg-gray-100', 'text-gray-600');
          this.classList.add('bg-[#0f766e]', 'text-white');
          filterRooms();
        });
      });

      // Search
      roomSearch.addEventListener('input', filterRooms);

      // Load more
      loadMoreBtn.addEventListener('click', function() {
        displayedCount += 12;
        renderRooms();
      });

      // Date change for estimate
      document.getElementById('checkInDate').addEventListener('change', updateEstimate);
      document.getElementById('checkOutDate').addEventListener('change', updateEstimate);
    }

    function filterRooms() {
      const activeTab = document.querySelector('.room-type-tab.bg-\\[\\#0f766e\\]');
      const selectedType = activeTab?.dataset.type || 'all';
      const searchTerm = roomSearch.value.toLowerCase();

      filteredRooms = allRooms.filter(room => {
        const matchesType = selectedType === 'all' || room.type === selectedType;
        const matchesSearch = room.number.toLowerCase().includes(searchTerm) || 
                              room.type.toLowerCase().includes(searchTerm);
        return matchesType && matchesSearch;
      });

      displayedCount = 12;
      renderRooms();
    }

    function renderRooms() {
      const toDisplay = filteredRooms.slice(0, displayedCount);
      
      if (filteredRooms.length === 0) {
        roomGrid.innerHTML = '';
        noRoomsMessage.classList.remove('hidden');
        showingInfo.textContent = 'No rooms found';
        loadMoreBtn.classList.add('hidden');
        return;
      }

      noRoomsMessage.classList.add('hidden');
      roomGrid.innerHTML = toDisplay.map(room => `
        <div class="room-card p-3 border-2 rounded-lg cursor-pointer transition hover:border-[#0f766e] hover:shadow-sm ${selectedRoom?.number === room.number ? 'border-[#0f766e] bg-teal-50' : 'border-gray-200'}"
             data-room='${JSON.stringify(room)}'>
          <div class="flex items-center justify-between mb-1">
            <span class="font-semibold text-gray-800">${room.number}</span>
            ${selectedRoom?.number === room.number ? '<svg class="w-5 h-5 text-[#0f766e]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>' : ''}
          </div>
          <p class="text-xs text-gray-500 capitalize">${room.type}</p>
          <p class="text-sm text-[#0f766e] font-medium mt-1">$${room.price}/night</p>
        </div>
      `).join('');

      // Update pagination info
      showingInfo.textContent = `Showing ${toDisplay.length} of ${filteredRooms.length} rooms`;
      loadMoreBtn.classList.toggle('hidden', toDisplay.length >= filteredRooms.length);

      // Add click handlers
      document.querySelectorAll('.room-card').forEach(card => {
        card.addEventListener('click', function() {
          selectRoom(JSON.parse(this.dataset.room));
        });
      });
    }

    function selectRoom(room) {
      selectedRoom = room;
      roomSelectInput.value = room.number;
      selectedRoomDisplay.textContent = `Room ${room.number} - ${room.type} ($${room.price}/night)`;
      selectedRoomSummary.classList.remove('hidden');
      
      // Enable submit button
      submitBtn.disabled = false;
      submitBtn.classList.remove('bg-gray-300', 'text-gray-500', 'cursor-not-allowed');
      submitBtn.classList.add('bg-[#0f766e]', 'text-white', 'hover:bg-teal-700');
      submitBtn.textContent = 'Check In Guest';

      renderRooms();
      updateEstimate();
    }

    function clearRoomSelection() {
      selectedRoom = null;
      roomSelectInput.value = '';
      selectedRoomSummary.classList.add('hidden');
      document.getElementById('stayEstimate').classList.add('hidden');
      
      // Disable submit button
      submitBtn.disabled = true;
      submitBtn.classList.add('bg-gray-300', 'text-gray-500', 'cursor-not-allowed');
      submitBtn.classList.remove('bg-[#0f766e]', 'text-white', 'hover:bg-teal-700');
      submitBtn.textContent = 'Select a room to continue';

      renderRooms();
    }

    function updateEstimate() {
      const checkIn = document.getElementById('checkInDate').value;
      const checkOut = document.getElementById('checkOutDate').value;
      const stayEstimate = document.getElementById('stayEstimate');

      if (checkIn && checkOut && selectedRoom) {
        const nights = Math.ceil((new Date(checkOut) - new Date(checkIn)) / (1000 * 60 * 60 * 24));
        if (nights > 0) {
          document.getElementById('nightsCount').textContent = nights;
          document.getElementById('estimatedCost').textContent = (nights * selectedRoom.price).toLocaleString();
          stayEstimate.classList.remove('hidden');
        } else {
          stayEstimate.classList.add('hidden');
        }
      } else {
        stayEstimate.classList.add('hidden');
      }
    }

    // Additional Guests Management
    function addGuest() {
      const guestId = ++guestIdCounter;
      const guestDiv = document.createElement('div');
      guestDiv.className = 'p-4 bg-gray-50 rounded-lg border border-gray-200';
      guestDiv.id = `guest-${guestId}`;
      guestDiv.innerHTML = `
        <div class="flex items-center justify-between mb-3">
          <span class="text-sm font-medium text-gray-700">Guest ${document.getElementById('additionalGuestsList').children.length + 2}</span>
          <button type="button" onclick="removeGuest(${guestId})" class="p-1 text-gray-400 hover:text-red-500 transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <div class="grid grid-cols-2 gap-3 mb-3">
          <input type="text" placeholder="First name" class="guest-firstName px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f766e] focus:border-transparent" required>
          <input type="text" placeholder="Last name" class="guest-lastName px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f766e] focus:border-transparent" required>
        </div>
        <div class="grid grid-cols-2 gap-3 mb-3">
          <input type="email" placeholder="Email (optional)" class="guest-email px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f766e] focus:border-transparent">
          <input type="tel" placeholder="Phone (optional)" class="guest-phone px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f766e] focus:border-transparent">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <input type="text" placeholder="ID/Passport (optional)" class="guest-idNumber px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f766e] focus:border-transparent">
          <select class="guest-type px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f766e] focus:border-transparent">
            <option value="adult">Adult (18+)</option>
            <option value="child">Child</option>
          </select>
        </div>
      `;
      document.getElementById('additionalGuestsList').appendChild(guestDiv);
      updateGuestData();
      document.getElementById('guestSummary').classList.remove('hidden');
    }

    function removeGuest(guestId) {
      document.getElementById(`guest-${guestId}`)?.remove();
      updateGuestData();
      if (document.getElementById('additionalGuestsList').children.length === 0) {
        document.getElementById('guestSummary').classList.add('hidden');
      }
    }

    function updateGuestData() {
      const guestElements = document.querySelectorAll('#additionalGuestsList > div');
      additionalGuests = [];
      let adults = 1; // Primary guest
      let children = 0;

      guestElements.forEach((el, index) => {
        const firstName = el.querySelector('.guest-firstName')?.value || '';
        const lastName = el.querySelector('.guest-lastName')?.value || '';
        const email = el.querySelector('.guest-email')?.value || '';
        const phone = el.querySelector('.guest-phone')?.value || '';
        const idNumber = el.querySelector('.guest-idNumber')?.value || '';
        const type = el.querySelector('.guest-type')?.value || 'adult';
        const isAdult = type === 'adult';
        
        additionalGuests.push({ 
          firstName,
          lastName,
          fullName: `${firstName} ${lastName}`.trim(),
          email,
          phone,
          idNumber,
          isAdult 
        });
        if (isAdult) adults++; else children++;
        
        // Update guest number label
        const label = el.querySelector('span.text-sm.font-medium');
        if (label) label.textContent = `Guest ${index + 2}`;
      });

      document.getElementById('additionalGuests').value = JSON.stringify(additionalGuests);
      document.getElementById('adultCount').textContent = adults;
      document.getElementById('childCount').textContent = children;
    }

    // Update guest data on any change
    document.getElementById('additionalGuestsList').addEventListener('change', updateGuestData);
    document.getElementById('additionalGuestsList').addEventListener('input', updateGuestData);

    // Form validation
    document.getElementById('checkinForm').addEventListener('submit', function(e) {
      if (!selectedRoom) {
        e.preventDefault();
        alert('Please select a room');
        return;
      }
      updateGuestData();
    });

    // Logout modal
    function showLogoutModal() {
      document.getElementById('logoutModal').classList.remove('hidden');
    }
    function hideLogoutModal() {
      document.getElementById('logoutModal').classList.add('hidden');
    }
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') hideLogoutModal();
    });

    // Mobile menu toggle
    function toggleMobileMenu() {
      const menu = document.getElementById('mobile-menu');
      const menuIcon = document.getElementById('menu-icon');
      const closeIcon = document.getElementById('close-icon');
      menu.classList.toggle('hidden');
      menuIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    }
  </script>

</div>