<!-- 
  GUEST CHECK-IN PAGE
  This page allows receptionists to check in guests and assign them to available rooms.
  
  BACKEND TODO:
  - Pass availableRooms array with room numbers and types from controller
  - Handle POST request from check-in form to create new guest entry
  - Validate all form fields before submission
  - Assign selected room to guest and update room status to 'Occupied'
  - Create guest record in guests.json with all form data
  - Redirect to dashboard or show success message after check-in
  
  FORM FIELDS:
  - firstName: Guest's first name
  - lastName: Guest's last name
  - email: Guest's email address
  - phone: Guest's phone number
  - idNumber: Guest's ID/passport number
  - checkInDate: Check-in date
  - checkOutDate: Expected check-out date
  - roomSelect: Selected room number (dropdown populated from availableRooms)
-->

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(25px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeInUp {
    animation: fadeInUp 0.8s ease-out forwards;
  }
</style>

<div class="min-h-screen bg-gray-100">

  <!-- ================= TOP HEADER ================= -->
  <header class="bg-[#0f766e] shadow-sm">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex items-center justify-between h-16">

        <div class="flex items-center gap-3">
          <div class="bg-white/20 p-2 rounded-lg">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <div>
            <h1 class="text-white font-semibold text-lg">StaySync</h1>
            <p class="text-white/80 text-xs">Receptionist Portal</p>
          </div>
        </div>

        <div class="w-28 h-9 bg-white/30 rounded-lg"></div>
      </div>
    </div>
  </header>

  <!-- ================= SECONDARY NAV ================= -->
  <nav class="bg-white border-b">
    <div class="max-w-7xl mx-auto px-6">
      <ul class="flex items-center gap-8 text-sm font-medium text-gray-600 h-12">
        <li><a href="/receptionist/dashboard" class="hover:text-[#0f766e]">Dashboard</a></li>
        <li>
          <a href="/receptionist/checkingguests" class="text-[#0f766e] border-b-2 border-[#0f766e] pb-2">
            Check-In
          </a>
        </li>
        <li><a href="/receptionist/checkoutguests" class="hover:text-[#0f766e]">Checkout</a></li>
        <li><a href="/receptionist/rooms" class="hover:text-[#0f766e]">Rooms</a></li>
        <li><a href="/receptionist/cleaning-requests" class="hover:text-[#0f766e]">Cleaning Requests</a></li>
        <li><a href="/receptionist/housekeepers" class="hover:text-[#0f766e]">Housekeepers</a></li>
      </ul>
    </div>
  </nav>

  <!-- ================= MAIN ================= -->
  <main class="max-w-7xl mx-auto px-6 py-10 space-y-10 animate-fadeInUp">

    <!-- ================= HERO (NARROW + GLASS) ================= -->
    <section class="relative rounded-2xl overflow-hidden h-[190px] shadow-md">

      <img src="/images/hotel-room.jpg" alt="Premium Hotel Room" class="absolute inset-0 w-full h-full object-cover">

      <!-- Teal Overlay -->
      <div class="absolute inset-0 bg-[#0f766e]/85"></div>

      <!-- Glass Panel -->
      <div class="relative z-10 h-full flex items-center">

        <div class="ml-10 backdrop-blur-md bg-white/10 
                    border border-white/20 
                    rounded-xl px-8 py-6 
                    shadow-lg">

          <h3 class="text-2xl font-bold text-white mb-2">
            Premium Accommodations
          </h3>

          <p class="text-white/90 text-sm">
            Find the perfect room for your guests
          </p>

        </div>

      </div>

    </section>

    <!-- ================= FORM + ROOMS ================= -->
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-8">

      <!-- FORM -->
      <section class="bg-white rounded-lg shadow-sm p-8 lg:col-span-3">
        <h3 class="text-xl font-semibold text-gray-800 mb-6">Guest Information</h3>

        <!-- BACKEND TODO: Form action should POST to /receptionist/checkin -->
        <form method="POST" action="/receptionist/checkin" class="space-y-6">



          <!-- Name Fields -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="firstName" class="block text-sm font-medium text-gray-700 mb-2">
                First Name
              </label>
              <input type="text" id="firstName" name="firstName" required
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f766e] focus:border-transparent bg-gray-50">
            </div>

            <div>
              <label for="lastName" class="block text-sm font-medium text-gray-700 mb-2">
                Last Name
              </label>
              <input type="text" id="lastName" name="lastName" required
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f766e] focus:border-transparent bg-gray-50">
            </div>
          </div>

          <!-- Contact Fields -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                Email
              </label>
              <input type="email" id="email" name="email" required
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f766e] focus:border-transparent bg-gray-50">
            </div>

            <div>
              <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">
                Phone Number
              </label>
              <input type="tel" id="phone" name="phone" required
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f766e] focus:border-transparent bg-gray-50">
            </div>
          </div>

          <!-- ID Number -->
          <div>
            <label for="idNumber" class="block text-sm font-medium text-gray-700 mb-2">
              ID Number
            </label>
            <input type="text" id="idNumber" name="idNumber" required
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f766e] focus:border-transparent bg-gray-50">
          </div>

          <!-- Date Fields -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="checkInDate" class="block text-sm font-medium text-gray-700 mb-2">
                Check-In Date
              </label>
              <input type="date" id="checkInDate" name="checkInDate" required
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f766e] focus:border-transparent bg-gray-50">
            </div>

            <div>
              <label for="checkOutDate" class="block text-sm font-medium text-gray-700 mb-2">
                Check-Out Date
              </label>
              <input type="date" id="checkOutDate" name="checkOutDate" required
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f766e] focus:border-transparent bg-gray-50">
            </div>
          </div>

          <!-- Room Selection -->
          <div>
            <label for="roomSelect" class="block text-sm font-medium text-gray-700 mb-2">
              Select Room
            </label>
            <select id="roomSelect" name="roomSelect" required
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0f766e] focus:border-transparent bg-gray-50">
              <option value="">Choose a room</option>
              {{#each availableRooms}}
              <option value="{{this.number}}">Room {{this.number}} ({{this.type}})</option>
              {{/each}}
            </select>
          </div>

          <!-- Submit Button -->
          <div class="pt-4">
            <button type="submit"
              class="w-full bg-[#0f766e] text-white px-8 py-3 rounded-lg hover:bg-teal-700 transition font-medium">
              Check In Guest
            </button>
          </div>

        </form>
      </section>

      <!-- Available Rooms List - Takes 2 columns (40%) -->
      <section class="bg-white rounded-lg shadow-sm p-8 lg:col-span-2">
        <h3 class="text-xl font-semibold text-gray-800 mb-6">Available Rooms</h3>

        <div class="space-y-3">

          {{#each availableRooms}}
          <div
            class="flex items-center justify-between p-4 border border-gray-200 rounded-lg hover:border-[#0f766e] transition">
            <div>
              <p class="font-semibold text-gray-800">Room {{this.number}}</p>
              <p class="text-sm text-gray-500">{{this.type}}</p>
            </div>
            <span class="text-sm text-gray-400">Floor {{this.floor}}</span>
          </div>
          {{/each}}

          {{#unless availableRooms.length}}
          <div class="p-4 text-center text-gray-500">
            <p>No available rooms at the moment</p>
          </div>
          {{/unless}}

        </div>
      </section>

    </div>

  </main>
</div>