        <div class="bg-white rounded-lg shadow-sm p-6 border-l-4 border-[#008080]">
          <div class="flex items-center gap-2 text-gray-600 text-sm mb-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
            Total Rooms
          </div>
          <p class="text-3xl font-bold text-gray-800">50</p>
          <p class="text-xs text-gray-500 mt-1">rooms</p>
        </div>

        <!-- Rooms Ready -->
        <!-- BACKEND TODO: Replace hardcoded value with {{roomsReady}} -->
        <div class="bg-white rounded-lg shadow-sm p-6 border-l-4 border-green-500">
          <div class="flex items-center gap-2 text-gray-600 text-sm mb-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Rooms Ready
          </div>
          <p class="text-3xl font-bold text-gray-800">35</p>
          <p class="text-xs text-gray-500 mt-1">available</p>
        </div>

        <!-- Pending Cleaning -->
        <!-- BACKEND TODO: Replace hardcoded value with {{pendingCleaning}} -->
        <div class="bg-white rounded-lg shadow-sm p-6 border-l-4 border-orange-500">
          <div class="flex items-center gap-2 text-gray-600 text-sm mb-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Pending Cleaning
          </div>
          <p class="text-3xl font-bold text-gray-800">8</p>
