    <!-- Our Property -->
    <section class="mb-6">
      <h3 class="text-lg font-semibold text-gray-800 mb-4">Our Property</h3>

      <!-- BACKEND TODO: Loop through {{propertyImages}} array -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Property Card 1 -->
        <div class="bg-white rounded-lg shadow-sm overflow-hidden">
          <img src="/images/luxury-suite.jpg" alt="Luxury Suites" class="w-full h-48 object-cover">
