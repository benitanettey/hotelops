          <div class="p-4">
            <h4 class="font-semibold text-gray-800 mb-1">Luxury Suites</h4>
            <p class="text-sm text-gray-600">Experience comfort at its finest with modern amenities</p>
          </div>
        </div>
        
        <!-- Property Card 2 -->
        <div class="bg-white rounded-lg shadow-sm overflow-hidden">
          <img 
            src="/images/premium-amenities.jpg" 
            alt="Premium Amenities" 
            class="w-full h-48 object-cover"
          >
          <div class="p-4">
            <h4 class="font-semibold text-gray-800 mb-1">Premium Amenities</h4>
