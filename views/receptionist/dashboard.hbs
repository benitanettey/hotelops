  <!-- Main Content -->
  <main class="container mx-auto px-4 py-8">
    <!-- Welcome Section -->
    <section class="bg-white rounded-lg shadow-sm mb-6 overflow-hidden">
      <div class="flex items-stretch">
        <div class="p-8 flex-1">
          <h2 class="text-2xl font-bold text-gray-800 mb-2">Welcome to StaySync</h2>
          <p class="text-gray-600 mb-6">Manage your hotel operations efficiently. Quick access to check-ins, room management, and housekeeping coordination.</p>
          
          <div class="flex gap-3">
            <a href="/receptionist/checkingguests" class="bg-[#008080] text-white px-6 py-2 rounded-lg hover:bg-teal-700 transition">
              New Check-In
            </a>
            <a href="/receptionist/checkoutguests" class="bg-teal-100 text-[#008080] px-6 py-2 rounded-lg hover:bg-teal-200 transition">
              Guest Checkout
            </a>
            <a href="/receptionist/rooms" class="border border-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-50 transition">
              View Rooms
            </a>
          </div>
        </div>
        
        <div class="w-1/2">
          <img 
            src="/images/hotel-lobby.jpg" 
            alt="Hotel Lobby" 
            class="w-full h-full object-cover"
          >
        </div>
      </div>
    </section>

    <!-- Overview Statistics -->
    <section class="mb-6">
      <h3 class="text-lg font-semibold text-gray-800 mb-4">Overview</h3>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Total Rooms -->
