    <!-- Occupancy Trends and Recent Activity Side by Side -->
    <section class="mb-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Occupancy Trends Chart - Takes 2 columns -->
      <div class="bg-white rounded-lg shadow-sm p-6 lg:col-span-2">
        <div class="flex items-center gap-2 mb-1">
          <svg class="w-5 h-5 text-[#008080]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
          </svg>
          <h3 class="text-lg font-semibold text-gray-800">Occupancy Trends</h3>
        </div>
        <p class="text-sm text-gray-500 mb-6">Weekly room occupancy rates</p>
        
        <!-- Chart Area -->
        <!-- BACKEND TODO: Integrate actual chart library (Chart.js, etc.) with {{occupancyData}} -->
        <div class="relative h-64 flex items-end justify-between gap-2 border-b border-l border-gray-200 px-4 pb-4">
          <!-- Y-axis labels -->
          <div class="absolute left-0 top-0 bottom-0 flex flex-col justify-between text-xs text-gray-500 pr-2">
            <span>60</span>
            <span>45</span>
            <span>30</span>
            <span>15</span>
          </div>
          
          <!-- Chart visualization (placeholder) -->
          <div class="flex-1 ml-8 h-full relative">
            <!-- SVG gradient area chart placeholder -->
            <svg class="w-full h-full" viewBox="0 0 700 200" preserveAspectRatio="none">
              <defs>
                <linearGradient id="chartGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" style="stop-color:#008080;stop-opacity:0.6" />
                  <stop offset="100%" style="stop-color:#008080;stop-opacity:0.1" />
                </linearGradient>
              </defs>
              <path d="M 0 120 L 100 100 L 200 80 L 300 90 L 400 60 L 500 50 L 600 70 L 700 40 L 700 200 L 0 200 Z" fill="url(#chartGradient)" />
              <path d="M 0 120 L 100 100 L 200 80 L 300 90 L 400 60 L 500 50 L 600 70 L 700 40" fill="none" stroke="#008080" stroke-width="2" />
            </svg>
          </div>
        </div>
      </div>

      <!-- Recent Activity - Takes 1 column -->
      <div class="bg-white rounded-lg shadow-sm p-6 lg:col-span-1">
        <div class="flex items-center gap-2 mb-1">
          <svg class="w-5 h-5 text-[#008080]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
