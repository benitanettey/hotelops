              </a>
            </li>
            <li>
              <a href="/receptionist/cleaning-requests" class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Cleaning Requests
              </a>
            </li>
            <li>
              <a href="/receptionist/housekeepers" class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Housekeepers
              </a>
            </li>
            
            <!-- Notification Icon -->
            <li>
              <button class="relative p-2 text-gray-600 hover:text-[#008080] transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
