          </li>

          <li class="flex items-start gap-3 pb-3 border-b border-gray-100">
            <div class="bg-[#008080] text-white rounded-full p-1.5 mt-1 flex-shrink-0">
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                <circle cx="10" cy="10" r="8" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-gray-800">Cleaning Complete</p>
              <p class="text-xs text-gray-600 truncate">Room 205</p>
              <p class="text-xs text-gray-400 mt-1">25 minutes ago</p>
            </div>
          </li>

          <li class="flex items-start gap-3">
            <div class="bg-[#008080] text-white rounded-full p-1.5 mt-1 flex-shrink-0">
