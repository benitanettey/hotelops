<div class="min-h-screen bg-gray-50">
  <!-- Sticky Header/Navigation -->
  <header class="bg-white shadow-sm sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between h-16">
        <!-- Logo and Brand (Far Left) -->
        <div class="flex items-center gap-3">
          <div class="bg-[#008080] text-white p-2 rounded-lg">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4">
              </path>
            </svg>
          </div>
          <h1 class="text-xl font-bold text-gray-800">{{hotelName}}</h1>
        </div>

        <!-- Desktop Navigation Links (Center) - Hidden on mobile -->
        <nav class="hidden md:flex flex-1 justify-center">
          <ul class="flex items-center gap-6">
            <li>
              <a href="/receptionist/dashboard"
                class="text-sm font-medium text-gray-900 hover:text-[#008080] transition">
                Dashboard
              </a>
            </li>
            <li>
              <a href="/receptionist/checkingguests"
                class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Check-In
              </a>
            </li>
            <li>
              <a href="/receptionist/checkoutguests"
                class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Checkout
              </a>
            </li>
            <li>
              <a href="/receptionist/rooms" class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Rooms
              </a>
            </li>
            <li>
              <a href="/receptionist/cleaning-requests"
                class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Cleaning Request
              </a>
            </li>
            <li>
              <a href="/receptionist/housekeepers"
                class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
                Housekeepers
              </a>
            </li>
          </ul>
        </nav>

        <!-- Right Side Icons (Far Right) - Hidden on mobile -->
        <div class="hidden md:flex items-center gap-4">
          <!-- User Profile - Links to Settings -->
          <a href="/receptionist/settings" class="w-8 h-8 bg-[#008080] rounded-full flex items-center justify-center text-white text-sm font-medium hover:bg-teal-700 transition" title="Settings">
            {{userInitial}}
          </a>

          <!-- Logout Button -->
          <button onclick="showLogoutModal()" class="flex items-center gap-2 text-gray-600 hover:text-red-600 transition" title="Logout">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
            <span class="text-sm font-medium">Logout</span>
          </button>
        </div>

        <!-- Mobile menu button -->
        <button onclick="toggleMobileMenu()" class="md:hidden p-2 rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-100">
          <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Menu (Hidden by default) -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200">
      <div class="px-4 py-3 space-y-1">
        <a href="/receptionist/dashboard" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-900 bg-gray-50">
          Dashboard
        </a>
        <a href="/receptionist/checkingguests" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          Check-In
        </a>
        <a href="/receptionist/checkoutguests" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          Checkout
        </a>
        <a href="/receptionist/rooms" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          Rooms
        </a>
        <a href="/receptionist/cleaning-requests" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          Cleaning Request
        </a>
        <a href="/receptionist/housekeepers" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
          Housekeepers
        </a>
        <div class="border-t border-gray-200 my-2 pt-2">
          <button onclick="showLogoutModal()" class="w-full text-left px-3 py-2 rounded-md text-sm font-medium text-red-600 hover:bg-red-50 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
            <span>Logout</span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- Logout Confirmation Modal -->
  <div id="logoutModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center">
    <div class="bg-white rounded-lg shadow-xl p-5 w-72 mx-4">
      <div class="text-center mb-4">
        <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-3">
          <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
        </div>
        <h3 class="text-base font-semibold text-gray-800">Logout?</h3>
      </div>
      <div class="flex gap-3">
        <button onclick="hideLogoutModal()" class="flex-1 bg-gray-200 text-gray-700 px-3 py-2 rounded-lg hover:bg-gray-300 transition font-medium text-sm">
          Cancel
        </button>
        <a href="/logout" class="flex-1 bg-red-600 text-white px-3 py-2 rounded-lg hover:bg-red-700 transition font-medium text-center text-sm">
          Logout
        </a>
      </div>
    </div>
  </div>

  <script>
    function showLogoutModal() {
      document.getElementById('logoutModal').classList.remove('hidden');
    }
    function hideLogoutModal() {
      document.getElementById('logoutModal').classList.add('hidden');
    }
    // Close modal on ESC key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') hideLogoutModal();
    });

    // Mobile menu toggle
    function toggleMobileMenu() {
      const menu = document.getElementById('mobile-menu');
      const menuIcon = document.getElementById('menu-icon');
      const closeIcon = document.getElementById('close-icon');
      
      menu.classList.toggle('hidden');
      menuIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    }

    // Render occupancy chart
    document.addEventListener('DOMContentLoaded', function() {
      const occupancyData = {{{occupancyData}}};
      const chartContainer = document.getElementById('occupancyChart');
      const labelsContainer = document.getElementById('occupancyLabels');
      
      if (!chartContainer || !labelsContainer) return;
      
      // Clear existing content
      chartContainer.innerHTML = '';
      labelsContainer.innerHTML = '';
      
      // If no data, show placeholder
      if (!occupancyData || occupancyData.length === 0) {
        chartContainer.innerHTML = `
          <div class="flex-1 flex flex-col items-center justify-center text-center py-8">
            <svg class="w-12 h-12 text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            <p class="text-gray-400 text-sm">No occupancy data yet</p>
            <p class="text-gray-300 text-xs mt-1">Check-in guests to see trends</p>
          </div>`;
        return;
      }
      
      // Check if all values are 0
      const allZero = occupancyData.every(d => d.occupancy === 0);
      
      if (allZero) {
        // Show a nice empty chart with day labels
        occupancyData.forEach((day) => {
          const bar = document.createElement('div');
          bar.className = 'flex-1 bg-gradient-to-t from-gray-200 to-gray-100 rounded-t-md relative';
          bar.style.height = '8px';
          bar.style.opacity = '0.6';
          chartContainer.appendChild(bar);
          
          const label = document.createElement('span');
          label.textContent = day.dayLabel;
          label.className = 'text-gray-400';
          labelsContainer.appendChild(label);
        });
        
        // Add overlay message
        const overlay = document.createElement('div');
        overlay.className = 'absolute inset-0 flex items-center justify-center';
        overlay.innerHTML = `
          <div class="text-center bg-white/90 px-4 py-3 rounded-lg shadow-sm">
            <p class="text-gray-500 text-sm font-medium">No guests this week</p>
            <p class="text-gray-400 text-xs">Start checking in guests</p>
          </div>`;
        chartContainer.style.position = 'relative';
        chartContainer.appendChild(overlay);
        return;
      }
      
      // Render bars with actual data
      occupancyData.forEach((day, index) => {
        // Calculate bar height as percentage of container (max 100%)
        const heightPercent = (day.occupancy / 100) * 100;
        
        // Create bar
        const bar = document.createElement('div');
        bar.className = 'flex-1 bg-gradient-to-t from-teal-600 to-teal-400 rounded-t-md relative group cursor-pointer hover:from-teal-700 hover:to-teal-500 transition-all';
        bar.style.height = `${Math.max(heightPercent, 4)}%`;
        bar.style.minHeight = '4px';
        
        // Add tooltip
        const tooltip = document.createElement('div');
        tooltip.className = 'absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 bg-gray-800 text-white text-xs rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap z-10';
        tooltip.textContent = `${day.occupancy}%`;
        bar.appendChild(tooltip);
        
        chartContainer.appendChild(bar);
        
        // Create label
        const label = document.createElement('span');
        label.textContent = day.dayLabel;
        labelsContainer.appendChild(label);
      });
    });
  </script>

  <!-- Main Content -->
  <main class="container mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
    <!-- Welcome Section -->
    <section class="bg-white rounded-lg shadow-sm mb-6 overflow-hidden">
      <div class="flex flex-col sm:flex-row items-stretch">
        <div class="p-6 sm:p-8 flex-1">
          <h2 class="text-2xl font-bold text-gray-800 mb-2">Welcome to StaySync</h2>
          <p class="text-gray-600 mb-6">Manage your hotel operations efficiently. Quick access to check-ins, room
            management, and housekeeping coordination.</p>

          <div class="flex gap-3">
            <a href="/receptionist/checkingguests"
              class="bg-[#008080] text-white px-6 py-2 rounded-lg hover:bg-teal-700 transition">
              New Check-In
            </a>
            <a href="/receptionist/checkoutguests"
              class="bg-teal-100 text-[#008080] px-6 py-2 rounded-lg hover:bg-teal-200 transition">
              Guest Checkout
            </a>
            <a href="/receptionist/rooms"
              class="border border-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-50 transition">
              View Rooms
            </a>
          </div>
        </div>

        <div class="w-1/2">
          <img src="/images/hotel-lobby.jpg" alt="Hotel Lobby" class="w-full h-full object-cover">
        </div>
      </div>
    </section>

    <!-- Overview Statistics -->
    <section class="mb-6">
      <h3 class="text-lg font-semibold text-gray-800 mb-4">Overview</h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Total Rooms -->
        <div class="bg-white rounded-lg shadow-sm p-6 border-l-4 border-[#008080]">
          <div class="flex items-center gap-2 text-gray-600 text-sm mb-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4">
              </path>
            </svg>
            Total Rooms
          </div>
          <p class="text-3xl font-bold text-gray-800">{{totalRooms}}</p>
          <p class="text-xs text-gray-500 mt-1">rooms</p>
        </div>

        <!-- Rooms Ready -->
        <div class="bg-white rounded-lg shadow-sm p-6 border-l-4 border-green-500">
          <div class="flex items-center gap-2 text-gray-600 text-sm mb-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Rooms Ready
          </div>
          <p class="text-3xl font-bold text-gray-800">{{roomsReady}}</p>
          <p class="text-xs text-gray-500 mt-1">available</p>
        </div>

        <!-- Pending Cleaning -->
        <div class="bg-white rounded-lg shadow-sm p-6 border-l-4 border-orange-500">
          <div class="flex items-center gap-2 text-gray-600 text-sm mb-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Pending Cleaning
          </div>
          <p class="text-3xl font-bold text-gray-800">{{pendingCleaning}}</p>
          <p class="text-xs text-gray-500 mt-1">rooms</p>
        </div>

        <!-- Occupied -->
        <div class="bg-white rounded-lg shadow-sm p-6 border-l-4 border-blue-500">
          <div class="flex items-center gap-2 text-gray-600 text-sm mb-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2">
              </path>
            </svg>
            Occupied
          </div>
          <p class="text-3xl font-bold text-gray-800">{{occupied}}</p>
          <p class="text-xs text-gray-500 mt-1">rooms</p>
        </div>
      </div>
    </section>

    <!-- Occupancy Trends and Recent Activity Side by Side -->
    <section class="mb-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Occupancy Trends Chart - Takes 2 columns -->
      <div class="bg-white rounded-lg shadow-sm p-6 lg:col-span-2">
        <div class="flex items-center gap-2 mb-1">
          <svg class="w-5 h-5 text-[#008080]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6">
            </path>
          </svg>
          <h3 class="text-lg font-semibold text-gray-800">Occupancy Trends</h3>
        </div>
        <p class="text-sm text-gray-500 mb-6">Weekly room occupancy rates</p>

        <!-- Chart Area - Dynamic Bar Chart -->
        <div class="relative h-64">
          <!-- Y-axis labels -->
          <div class="absolute left-0 top-0 bottom-8 flex flex-col justify-between text-xs text-gray-500 w-8">
            <span>100%</span>
            <span>75%</span>
            <span>50%</span>
            <span>25%</span>
            <span>0%</span>
          </div>
          
          <!-- Chart bars container -->
          <div id="occupancyChart" class="ml-10 h-52 flex items-end justify-around gap-2">
            <!-- Bars will be generated by JavaScript -->
          </div>
          
          <!-- X-axis labels -->
          <div id="occupancyLabels" class="ml-10 flex justify-around text-xs text-gray-500 mt-2">
            <!-- Labels will be generated by JavaScript -->
          </div>
        </div>
      </div>

      <!-- Recent Activity - Takes 1 column -->
      <div class="bg-white rounded-lg shadow-sm p-6 lg:col-span-1 flex flex-col">
        <div class="flex items-center gap-2 mb-1">
          <svg class="w-5 h-5 text-[#008080]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <h3 class="text-lg font-semibold text-gray-800">Recent Activity</h3>
        </div>
        <p class="text-sm text-gray-500 mb-4">Latest system updates</p>

        <!-- Activity List - Fixed height matching chart (h-52 = 208px) with visible scroll -->
        <ul class="activity-scroll space-y-3 h-52 overflow-y-auto pr-2 flex-shrink-0" style="scrollbar-width: thin; scrollbar-color: #9ca3af #f3f4f6;">
          {{#each recentActivities}}
          <li class="flex items-start gap-3 pb-3 {{#unless @last}}border-b border-gray-100{{/unless}}">
            <div class="bg-[#008080] text-white rounded-full p-1.5 mt-1 flex-shrink-0">
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                <circle cx="10" cy="10" r="8" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-gray-800">{{description}}</p>
              <p class="text-xs text-gray-600 truncate">{{details}}</p>
              <p class="text-xs text-gray-400 mt-1">{{time}}</p>
            </div>
          </li>
          {{else}}
          <li class="text-center py-4 text-gray-500 text-sm">No recent activity</li>
          {{/each}}
        </ul>
      </div>
    </section>

    <!-- Our Property -->
    <section class="mb-6">
      <h3 class="text-lg font-semibold text-gray-800 mb-4">Our Property</h3>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Property Card 1 -->
        <div class="bg-white rounded-lg shadow-sm overflow-hidden">
          <img src="/images/luxury-suite.jpg" alt="Luxury Suites" class="w-full h-48 object-cover">
          <div class="p-4">
            <h4 class="font-semibold text-gray-800 mb-1">Luxury Suites</h4>
            <p class="text-sm text-gray-600">Experience comfort at its finest with modern amenities</p>
          </div>
        </div>

        <!-- Property Card 2 -->
        <div class="bg-white rounded-lg shadow-sm overflow-hidden">
          <img src="/images/premium-amenities.jpg" alt="Premium Amenities" class="w-full h-48 object-cover">
          <div class="p-4">
            <h4 class="font-semibold text-gray-800 mb-1">Premium Amenities</h4>
            <p class="text-sm text-gray-600">Top-tier facilities and services</p>
          </div>
        </div>

        <!-- Property Card 3 -->
        <div class="bg-white rounded-lg shadow-sm overflow-hidden">
          <img src="/images/spa-bathroom.jpg" alt="Spa-like Bathrooms" class="w-full h-48 object-cover">
          <div class="p-4">
            <h4 class="font-semibold text-gray-800 mb-1">Spa-like Bathrooms</h4>
            <p class="text-sm text-gray-600">Elegance and comfort combined</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</div>

<style>
  /* Webkit scrollbar styling for recent activity - more visible */
  .activity-scroll::-webkit-scrollbar {
    width: 8px;
  }
  .activity-scroll::-webkit-scrollbar-track {
    background: #e5e7eb;
    border-radius: 4px;
  }
  .activity-scroll::-webkit-scrollbar-thumb {
    background: #9ca3af;
    border-radius: 4px;
  }
  .activity-scroll::-webkit-scrollbar-thumb:hover {
    background: #6b7280;
  }
</style>