            </svg>
          </div>
          <h1 class="text-xl font-bold text-gray-800">StaySync</h1>
        </div>
        
        <!-- Navigation Links -->
        <nav>
          <ul class="flex items-center gap-8">
            <li>
              <a href="/receptionist/dashboard" class="text-sm font-medium text-gray-900 hover:text-[#008080] transition">
                Dashboard
              </a>
            </li>
            <li>
              <a href="/receptionist/checkingguests" class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
