<!-- ================= UNIFIED HEADER ================= -->
<header class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16">
      <!-- Logo and Brand (Far Left) -->
      <div class="flex items-center gap-3">
        <div class="bg-[#008080] text-white p-2 rounded-lg">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4">
            </path>
          </svg>
        </div>
        <h1 class="text-xl font-bold text-gray-800">{{hotelName}}</h1>
      </div>

      <!-- Desktop Navigation Links (Center) - Hidden on mobile -->
      <nav class="hidden md:flex flex-1 justify-center">
        <ul class="flex items-center gap-6">
          <li>
            <a href="/receptionist/dashboard"
              class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
              Dashboard
            </a>
          </li>
          <li>
            <a href="/receptionist/checkingguests"
              class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
              Check-In
            </a>
          </li>
          <li>
            <a href="/receptionist/checkoutguests"
              class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
              Checkout
            </a>
          </li>
          <li>
            <a href="/receptionist/rooms" class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
              Rooms
            </a>
          </li>
          <li>
            <a href="/receptionist/cleaning-requests"
              class="text-sm font-medium text-gray-900 hover:text-[#008080] transition">
              Cleaning Request
            </a>
          </li>
          <li>
            <a href="/receptionist/housekeepers"
              class="text-sm font-medium text-gray-600 hover:text-[#008080] transition">
              Housekeepers
            </a>
          </li>
        </ul>
      </nav>

      <!-- Right Side Icons (Far Right) - Hidden on mobile -->
      <div class="hidden md:flex items-center gap-4">
        <!-- User Profile - Links to Settings -->
        <a href="/receptionist/settings" class="w-8 h-8 bg-[#008080] rounded-full flex items-center justify-center text-white text-sm font-medium hover:bg-teal-700 transition" title="Settings">
          {{userInitial}}
        </a>

        <!-- Logout Button -->
        <button onclick="showLogoutModal()" class="flex items-center gap-2 text-gray-600 hover:text-red-600 transition" title="Logout">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
          <span class="text-sm font-medium">Logout</span>
        </button>
      </div>

      <!-- Mobile menu button -->
      <button onclick="toggleMobileMenu()" class="md:hidden p-2 rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-100">
        <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Menu (Hidden by default) -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200">
    <div class="px-4 py-3 space-y-1">
      <a href="/receptionist/dashboard" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
        Dashboard
      </a>
      <a href="/receptionist/checkingguests" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
        Check-In
      </a>
      <a href="/receptionist/checkoutguests" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
        Checkout
      </a>
      <a href="/receptionist/rooms" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
        Rooms
      </a>
      <a href="/receptionist/cleaning-requests" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-900 bg-gray-50">
        Cleaning Request
      </a>
      <a href="/receptionist/housekeepers" class="block px-3 py-2 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-50">
        Housekeepers
      </a>
      <div class="border-t border-gray-200 my-2 pt-2">
        <button onclick="showLogoutModal()" class="w-full text-left px-3 py-2 rounded-md text-sm font-medium text-red-600 hover:bg-red-50 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
          <span>Logout</span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- ================= MAIN ================= -->
<main class="max-w-7xl mx-auto px-6 py-8 space-y-10">

  <!-- SUCCESS TOAST -->
  {{#if success}}
  <div class="fixed top-6 right-6 bg-green-600 text-white px-6 py-3 rounded-xl shadow-lg">
    {{success}}
  </div>
  {{/if}}

  <!-- ================= HERO BANNER ================= -->
  <div class="relative rounded-2xl overflow-hidden h-[220px]">

    <!-- Background Image -->
    <img src="/images/cleaning-tasks.jpg" class="absolute inset-0 w-full h-full object-cover" />

    <!-- Teal Overlay -->
    <div class="absolute inset-0 bg-[#0f766e]/85"></div>

    <!-- Glass Panel -->
    <div class="relative z-10 h-full flex items-center">

      <div class="backdrop-blur-md bg-white/10 border border-white/20
                    rounded-xl px-8 py-6 max-w-xl ml-8
                    animate-fadeIn">

        <h3 class="text-2xl font-semibold text-white mb-2">
          Cleaning Operations
        </h3>

        <p class="text-white/90 text-sm mb-4">
          Efficient room maintenance and cleaning coordination.
        </p>

        <div class="inline-flex items-center gap-2 bg-white/20
                      px-4 py-1.5 rounded-full text-white text-xs font-medium">

          <span class="w-2 h-2 bg-yellow-400 rounded-full animate-pulse"></span>

          {{activeRequests}} Active Requests
        </div>

      </div>

    </div>
  </div>

  <!-- ================= GRID LAYOUT ================= -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

    <!-- ================= FORM CARD ================= -->
    <div class="bg-white rounded-2xl shadow-sm p-8">

      <h3 class="text-lg font-semibold text-gray-800 mb-6">
        New Cleaning Request
      </h3>

      <form method="POST" action="/receptionist/cleaning-requests" class="space-y-5">

        <!-- Location Type Toggle -->
        <div>
          <label class="text-sm font-medium text-gray-600 mb-2 block">
            Location Type
          </label>
          <div class="flex gap-2">
            <button type="button" id="roomTypeBtn" onclick="setLocationType('room')"
              class="flex-1 px-4 py-2 rounded-lg text-sm font-medium transition border border-gray-200 bg-[#0f766e] text-white">
              Room
            </button>
            <button type="button" id="customTypeBtn" onclick="setLocationType('custom')"
              class="flex-1 px-4 py-2 rounded-lg text-sm font-medium transition border border-gray-200 bg-gray-50 text-gray-600 hover:bg-gray-100">
              Custom Location
            </button>
          </div>
        </div>

        <!-- Room Number (shown by default) -->
        <div id="roomNumberField">
          <label class="text-sm font-medium text-gray-600">
            Room Number
          </label>
          <input type="text" name="roomNumber" id="roomNumberInput" placeholder="e.g., 101"
            class="w-full mt-1 px-4 py-2 rounded-lg bg-gray-50 border border-gray-200 focus:ring-2 focus:ring-[#0f766e] focus:border-transparent outline-none">
        </div>

        <!-- Custom Location (hidden by default) -->
        <div id="customLocationField" class="hidden">
          <label class="text-sm font-medium text-gray-600">
            Location Name
          </label>
          <input type="text" name="location" id="locationInput" placeholder="e.g., Lobby, Gym, Pool Area"
            class="w-full mt-1 px-4 py-2 rounded-lg bg-gray-50 border border-gray-200 focus:ring-2 focus:ring-[#0f766e] focus:border-transparent outline-none">
        </div>

        <div>
          <label class="text-sm font-medium text-gray-600">
            Priority
          </label>
          <select name="priority"
            class="w-full mt-1 px-4 py-2 rounded-lg bg-gray-50 border border-gray-200 focus:ring-2 focus:ring-[#0f766e] focus:border-transparent outline-none">
            <option value="Low">Low</option>
            <option value="High">High</option>
          </select>
        </div>

        <div>
          <label class="text-sm font-medium text-gray-600">
            Notes
          </label>
          <textarea name="instructions" rows="3"
            class="w-full mt-1 px-4 py-2 rounded-lg bg-gray-50 border border-gray-200 focus:ring-2 focus:ring-[#0f766e] focus:border-transparent outline-none resize-none"></textarea>
        </div>

        <button class="w-full bg-[#0f766e] hover:bg-teal-700 text-white py-2.5 rounded-lg font-medium transition">
          Create Request
        </button>

      </form>
    </div>

    <!-- ================= TABLE CARD ================= -->
    <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm p-8">

      <h3 class="text-lg font-semibold text-gray-800 mb-6">
        All Requests
      </h3>

      <div class="overflow-x-auto">
        <table class="w-full text-sm">

          <thead class="text-gray-500 border-b">
            <tr>
              <th class="text-left py-3 font-medium">Location</th>
              <th class="text-left py-3 font-medium">Priority</th>
              <th class="text-left py-3 font-medium">Status</th>
              <th class="text-left py-3 font-medium">Assigned</th>
              <th class="text-left py-3 font-medium">Notes</th>
              <th class="text-left py-3 font-medium">Time</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-gray-100">

            {{#each cleaningRequests}}
            <tr class="hover:bg-gray-50 transition">

              <td class="py-3">
                {{#if roomNumber}}
                  <span class="font-medium">Room {{roomNumber}}</span>
                {{else}}
                  <span class="text-teal-600">{{location}}</span>
                {{/if}}
              </td>

              <td class="py-3">
                {{#if (eq priority "High")}}
                <span class="px-3 py-1 text-xs rounded-full bg-red-100 text-red-600">High</span>
                {{else}}
                <span class="px-3 py-1 text-xs rounded-full bg-gray-200 text-gray-600">Low</span>
                {{/if}}
              </td>

              <td class="py-3">
                {{#if (eq status "In Progress")}}
                <span class="px-3 py-1 text-xs rounded-full bg-blue-100 text-blue-600">In Progress</span>
                {{else}}
                {{#if (eq status "Pending")}}
                <span class="px-3 py-1 text-xs rounded-full bg-yellow-100 text-yellow-700">Pending</span>
                {{else}}
                <span class="px-3 py-1 text-xs rounded-full bg-green-100 text-green-600">Completed</span>
                {{/if}}
                {{/if}}
              </td>

              <td class="py-3">
                {{#if assignedTo}}
                {{assignedTo.name}}
                {{else}}
                <span class="text-gray-400">-</span>
                {{/if}}
              </td>

              <td class="py-3 text-gray-500">
                {{instructions}}
              </td>

              <td class="py-3 text-gray-500">
                {{time}}
              </td>

            </tr>
            {{/each}}

          </tbody>
        </table>
      </div>

    </div>
  </div>

</main>

<!-- Logout Confirmation Modal -->
<div id="logoutModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center">
  <div class="bg-white rounded-lg shadow-xl p-5 w-72 mx-4">
    <div class="text-center mb-4">
      <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-3">
        <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
        </svg>
      </div>
      <h3 class="text-base font-semibold text-gray-800">Logout?</h3>
    </div>
    <div class="flex gap-3">
      <button onclick="hideLogoutModal()" class="flex-1 bg-gray-200 text-gray-700 px-3 py-2 rounded-lg hover:bg-gray-300 transition font-medium text-sm">
        Cancel
      </button>
      <a href="/logout" class="flex-1 bg-red-600 text-white px-3 py-2 rounded-lg hover:bg-red-700 transition font-medium text-center text-sm">
        Logout
      </a>
    </div>
  </div>
</div>

<script>
  function showLogoutModal() {
    document.getElementById('logoutModal').classList.remove('hidden');
  }
  function hideLogoutModal() {
    document.getElementById('logoutModal').classList.add('hidden');
  }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') hideLogoutModal();
  });

  // Mobile menu toggle
  function toggleMobileMenu() {
    const menu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');
    
    menu.classList.toggle('hidden');
    menuIcon.classList.toggle('hidden');
    closeIcon.classList.toggle('hidden');
  }

  // Location type toggle (room vs custom location)
  function setLocationType(type) {
    const roomBtn = document.getElementById('roomTypeBtn');
    const customBtn = document.getElementById('customTypeBtn');
    const roomField = document.getElementById('roomNumberField');
    const customField = document.getElementById('customLocationField');
    const roomInput = document.getElementById('roomNumberInput');
    const locationInput = document.getElementById('locationInput');
    
    if (type === 'room') {
      roomBtn.classList.remove('bg-gray-50', 'text-gray-600', 'hover:bg-gray-100');
      roomBtn.classList.add('bg-[#0f766e]', 'text-white');
      customBtn.classList.remove('bg-[#0f766e]', 'text-white');
      customBtn.classList.add('bg-gray-50', 'text-gray-600', 'hover:bg-gray-100');
      roomField.classList.remove('hidden');
      customField.classList.add('hidden');
      roomInput.required = true;
      locationInput.required = false;
      locationInput.value = '';
    } else {
      customBtn.classList.remove('bg-gray-50', 'text-gray-600', 'hover:bg-gray-100');
      customBtn.classList.add('bg-[#0f766e]', 'text-white');
      roomBtn.classList.remove('bg-[#0f766e]', 'text-white');
      roomBtn.classList.add('bg-gray-50', 'text-gray-600', 'hover:bg-gray-100');
      customField.classList.remove('hidden');
      roomField.classList.add('hidden');
      locationInput.required = true;
      roomInput.required = false;
      roomInput.value = '';
    }
  }
</script>

</div>

<!-- ================= FADE ANIMATION ================= -->
<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeIn {
    animation: fadeIn 0.7s ease-out forwards;
  }
</style>