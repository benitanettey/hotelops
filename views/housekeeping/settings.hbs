<div class="min-h-screen bg-gray-100">

  <!-- ================= TOP HEADER ================= -->
  <header class="bg-[#0a5c56] shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex justify-between items-center h-16 text-white">

        <!-- Logo -->
        <a href="/housekeeping/dashboard" class="flex items-center gap-3">
          <div class="bg-white/10 p-2 rounded-lg backdrop-blur-sm">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4">
              </path>
            </svg>
          </div>
          <div>
            <h1 class="text-lg font-semibold">{{hotelName}}</h1>
            <p class="text-xs opacity-80">Housekeeping Portal</p>
          </div>
        </a>

        <!-- Right Side - Hidden on mobile -->
        <div class="hidden md:flex items-center gap-3">
          <!-- Dashboard Link -->
          <a href="/housekeeping/dashboard" class="flex items-center gap-2 bg-white/10 hover:bg-white/20 px-4 py-1.5 rounded-full backdrop-blur-sm border border-white/20 transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
            <span class="text-sm font-medium">Dashboard</span>
          </a>

          <!-- Logout Button -->
          <button onclick="showLogoutModal()" class="flex items-center gap-2 bg-white/10 hover:bg-white/20 px-4 py-1.5 rounded-full backdrop-blur-sm border border-white/20 transition group">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
            <span class="text-sm font-medium">Logout</span>
          </button>
        </div>

        <!-- Mobile menu button -->
        <button onclick="toggleMobileMenu()" class="md:hidden p-2 rounded-md text-white hover:bg-white/10">
          <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Menu -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-white/20">
      <div class="px-4 py-3 space-y-2">
        <a href="/housekeeping/dashboard" class="flex items-center gap-2 w-full bg-white/10 px-4 py-2 rounded-lg text-sm font-medium">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
          </svg>
          <span>Dashboard</span>
        </a>
        <div class="border-t border-white/20 pt-2">
          <button onclick="showLogoutModal()" class="w-full text-left px-4 py-2 rounded-lg text-sm font-medium hover:bg-white/10 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
            <span>Logout</span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- ================= MAIN CONTENT ================= -->
  <main class="max-w-4xl mx-auto px-6 py-8 space-y-8">

    <!-- Page Title -->
    <div>
      <h2 class="text-2xl font-semibold text-gray-800">Settings</h2>
      <p class="text-sm text-gray-500 mt-1">Manage your profile and preferences</p>
    </div>

    <!-- Success/Error Messages -->
    {{#if success}}
    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg text-sm">
      Profile updated successfully!
    </div>
    {{/if}}
    {{#if error}}
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm">
      {{error}}
    </div>
    {{/if}}

    <!-- ================= PROFILE SECTION ================= -->
    <div class="bg-white rounded-xl shadow-sm p-6">
      <div class="flex items-center gap-6 mb-6">
        <!-- Profile Picture -->
        <div class="w-20 h-20 rounded-full bg-[#0a5c56] flex items-center justify-center text-white text-3xl font-bold">
          {{substring housekeeper.name 0 1}}
        </div>
        <div>
          <h3 class="text-xl font-semibold text-gray-800">{{housekeeper.name}}</h3>
          <p class="text-sm text-gray-500">@{{housekeeper.username}}</p>
          <div class="flex items-center gap-2 mt-2">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 text-xs font-medium rounded-full
              {{#if housekeeper.isActive}}bg-green-100 text-green-700{{else}}bg-gray-100 text-gray-500{{/if}}">
              <span class="w-2 h-2 rounded-full {{#if housekeeper.isActive}}bg-green-500{{else}}bg-gray-400{{/if}}"></span>
              {{#if housekeeper.isActive}}Online{{else}}Offline{{/if}}
            </span>
            <span class="text-xs text-gray-400">•</span>
            <span class="text-xs text-gray-500">Joined {{housekeeper.joinDate}}</span>
          </div>
        </div>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-2 gap-4 mb-6">
        <div class="bg-gray-50 rounded-lg p-4 text-center">
          <p class="text-2xl font-bold text-[#0a5c56]">{{housekeeper.totalCompleted}}</p>
          <p class="text-xs text-gray-500">Total Tasks Completed</p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4 text-center">
          <p class="text-2xl font-bold text-green-600">{{housekeeper.completedToday}}</p>
          <p class="text-xs text-gray-500">Completed Today</p>
        </div>
      </div>
    </div>

    <!-- ================= UPDATE PROFILE SECTION ================= -->
    <div class="bg-white rounded-xl shadow-sm p-6">
      <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-[#0a5c56]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
        </svg>
        Update Profile
      </h3>

      <form method="POST" action="/housekeeping/settings/profile" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Display Name</label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              value="{{housekeeper.name}}"
              required
              class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#0a5c56] focus:border-transparent"
            >
          </div>
          <div>
            <label for="username" class="block text-sm font-medium text-gray-700 mb-1">Username</label>
            <input 
              type="text" 
              id="username" 
              value="{{housekeeper.username}}"
              disabled
              class="w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg bg-gray-50 text-gray-500 cursor-not-allowed"
            >
            <p class="mt-1 text-xs text-gray-500">Username cannot be changed</p>
          </div>
        </div>
        <div>
          <button type="submit" class="bg-[#0a5c56] text-white px-6 py-2 rounded-lg hover:bg-teal-700 transition text-sm font-medium">
            Update Profile
          </button>
        </div>
      </form>
    </div>

    <!-- ================= QUICK ACTIONS ================= -->
    <div class="bg-white rounded-xl shadow-sm p-6">
      <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-[#0a5c56]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
        </svg>
        Quick Actions
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Toggle Status -->
        <form method="POST" action="/housekeeping/toggle-status">
          <button type="submit" class="w-full flex items-center justify-between p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full {{#if housekeeper.isActive}}bg-green-100{{else}}bg-gray-100{{/if}} flex items-center justify-center">
                <svg class="w-5 h-5 {{#if housekeeper.isActive}}text-green-600{{else}}text-gray-500{{/if}}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.636 18.364a9 9 0 010-12.728m12.728 0a9 9 0 010 12.728m-9.9-2.829a5 5 0 010-7.07m7.072 0a5 5 0 010 7.07M13 12a1 1 0 11-2 0 1 1 0 012 0z"></path>
                </svg>
              </div>
              <div class="text-left">
                <p class="text-sm font-medium text-gray-800">{{#if housekeeper.isActive}}Go Offline{{else}}Go Online{{/if}}</p>
                <p class="text-xs text-gray-500">Currently {{#if housekeeper.isActive}}receiving{{else}}not receiving{{/if}} tasks</p>
              </div>
            </div>
            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </button>
        </form>

        <!-- Back to Dashboard -->
        <a href="/housekeeping/dashboard" class="w-full flex items-center justify-between p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-[#0a5c56]/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-[#0a5c56]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
              </svg>
            </div>
            <div class="text-left">
              <p class="text-sm font-medium text-gray-800">View Tasks</p>
              <p class="text-xs text-gray-500">Return to your dashboard</p>
            </div>
          </div>
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>

  </main>

  <!-- Logout Confirmation Modal -->
  <div id="logoutModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center">
    <div class="bg-white rounded-lg shadow-xl p-5 max-w-xs w-full mx-4">
      <div class="text-center mb-4">
        <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-3">
          <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-800 mb-1">Confirm Logout</h3>
        <p class="text-sm text-gray-600">Are you sure?</p>
      </div>
      <div class="flex gap-2">
        <button onclick="hideLogoutModal()" class="flex-1 bg-gray-200 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-300 transition font-medium text-sm">
          Cancel
        </button>
        <a href="/logout" class="flex-1 bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition font-medium text-center text-sm">
          Yes, Logout
        </a>
      </div>
    </div>
  </div>

  <script>
    function showLogoutModal() {
      document.getElementById('logoutModal').classList.remove('hidden');
    }
    function hideLogoutModal() {
      document.getElementById('logoutModal').classList.add('hidden');
    }
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') hideLogoutModal();
    });

    // Mobile menu toggle
    function toggleMobileMenu() {
      const menu = document.getElementById('mobile-menu');
      const menuIcon = document.getElementById('menu-icon');
      const closeIcon = document.getElementById('close-icon');
      
      menu.classList.toggle('hidden');
      menuIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    }
  </script>

</div>
