<!-- 
  HOUSEKEEPING DASHBOARD

  BACKEND TODO:
  - Ensure only logged-in housekeepers can access this page
  - Filter tasks by logged-in housekeeper ID
  - Pass:
      {
        housekeeper: { name, isActive },
        tasks: [],
        stats: {
          pending,
          inProgress,
          completed
        }
      }
  - Handle POST /housekeeping/toggle-status
  - Handle POST /housekeeping/start/:taskId
  - Handle POST /housekeeping/complete/:taskId
-->

<div class="min-h-screen bg-gray-100">

  <!-- ================= TOP HEADER ================= -->
  <header class="bg-[#0a5c56] shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex justify-between items-center h-16 text-white">

        <!-- Logo -->
        <div>
          <h1 class="text-lg font-semibold">StaySync</h1>
          <p class="text-xs opacity-80">Housekeeping Portal</p>
        </div>

        <!-- Right Side: Toggle + Logout - Hidden on mobile -->
        <div class="hidden md:flex items-center gap-3">
          <!-- Active Toggle -->
          <form method="POST" action="/housekeeping/toggle-status">
            <button
              class="flex items-center gap-3 bg-white/10 px-4 py-1.5 rounded-full backdrop-blur-sm border border-white/20 hover:bg-white/20 transition">

              <span class="text-sm font-medium">
                {{#if housekeeper.isActive}}Active{{else}}Offline{{/if}}
              </span>

              <span class="relative inline-flex items-center h-5 w-9 rounded-full 
                {{#if housekeeper.isActive}}bg-green-500{{else}}bg-gray-400{{/if}}">
                <span class="inline-block w-4 h-4 transform bg-white rounded-full transition 
                  {{#if housekeeper.isActive}}translate-x-4{{else}}translate-x-1{{/if}}">
                </span>
              </span>

            </button>
          </form>

          <!-- Logout Button -->
          <button onclick="showLogoutModal()" class="flex items-center gap-2 bg-white/10 hover:bg-white/20 px-4 py-1.5 rounded-full backdrop-blur-sm border border-white/20 transition group">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
            <span class="text-sm font-medium">Logout</span>
          </button>
        </div>

        <!-- Mobile menu button -->
        <button onclick="toggleMobileMenu()" class="md:hidden p-2 rounded-md text-white hover:bg-white/10">
          <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Menu (Hidden by default) -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-white/20">
      <div class="px-4 py-3 space-y-2">
        <!-- Active Toggle (Mobile) -->
        <form method="POST" action="/housekeeping/toggle-status">
          <button
            class="w-full flex items-center justify-between bg-white/10 px-4 py-2 rounded-lg backdrop-blur-sm border border-white/20 hover:bg-white/20 transition">
            <span class="text-sm font-medium">
              {{#if housekeeper.isActive}}Active{{else}}Offline{{/if}}
            </span>
            <span class="relative inline-flex items-center h-5 w-9 rounded-full 
              {{#if housekeeper.isActive}}bg-green-500{{else}}bg-gray-400{{/if}}">
              <span class="inline-block w-4 h-4 transform bg-white rounded-full transition 
                {{#if housekeeper.isActive}}translate-x-4{{else}}translate-x-1{{/if}}">
              </span>
            </span>
          </button>
        </form>
        
        <!-- Logout (Mobile) -->
        <div class="border-t border-white/20 pt-2">
          <button onclick="showLogoutModal()" class="w-full text-left px-4 py-2 rounded-lg text-sm font-medium text-white hover:bg-white/10 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
            <span>Logout</span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- ================= MAIN ================= -->
  <main class="max-w-7xl mx-auto px-6 py-8 space-y-10">

    <!-- Page Intro -->
    <div class="animate-fadeIn">
      <h2 class="text-2xl font-semibold text-gray-800">My Tasks</h2>
      <p class="text-sm text-gray-500 mt-1">
        Your assigned cleaning tasks for today
      </p>
    </div>

    <!-- ================= HERO BANNER ================= -->
    <div class="relative rounded-2xl overflow-hidden h-[180px] animate-fadeIn">

      <img src="/images/cleaningsupplies.jpg" class="absolute inset-0 w-full h-full object-cover" />

      <div class="absolute inset-0 bg-[#0a5c56]/85"></div>

      <div class="relative z-10 h-full flex items-center">

        <div class="ml-8 backdrop-blur-md bg-white/10 border border-white/20
                    rounded-xl px-8 py-6 max-w-xl">

          <h3 class="text-2xl font-semibold text-white mb-2">
            Quality Service
          </h3>

          <p class="text-white/90 text-sm">
            Ensuring guest satisfaction through excellence
          </p>

        </div>

      </div>
    </div>

    <!-- ================= STATS ================= -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 animate-fadeIn">

      <div class="bg-white rounded-xl shadow-sm p-6 border-t-4 border-yellow-500">
        <p class="text-3xl font-bold text-yellow-600">{{stats.pending}}</p>
        <p class="text-sm text-gray-500 mt-1">Pending Tasks</p>
      </div>

      <div class="bg-white rounded-xl shadow-sm p-6 border-t-4 border-blue-500">
        <p class="text-3xl font-bold text-blue-600">{{stats.inProgress}}</p>
        <p class="text-sm text-gray-500 mt-1">In Progress</p>
      </div>

      <div class="bg-white rounded-xl shadow-sm p-6 border-t-4 border-green-500">
        <p class="text-3xl font-bold text-green-600">{{stats.completed}}</p>
        <p class="text-sm text-gray-500 mt-1">Completed Today</p>
      </div>

    </div>

    <!-- ================= TASK TABLE ================= -->
    <div class="bg-white rounded-2xl shadow-sm p-8 animate-fadeIn">

      <h3 class="text-lg font-semibold text-gray-800 mb-6">
        Assigned Tasks
      </h3>

      <div class="overflow-x-auto">
        <table class="w-full text-sm">

          <thead class="text-gray-500 border-b">
            <tr>
              <th class="text-left py-3 font-medium">Room</th>
              <th class="text-left py-3 font-medium">Status</th>
              <th class="text-left py-3 font-medium">Notes</th>
              <th class="text-left py-3 font-medium">Assigned At</th>
              <th class="text-left py-3 font-medium">Actions</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-gray-100">

            {{#each tasks}}
            <tr class="hover:bg-gray-50 transition">

              <td class="py-4 font-medium text-gray-800">
                {{roomNumber}}
              </td>

              <td class="py-4">
                {{#if (eq status "pending")}}
                <span class="px-3 py-1 text-xs rounded-full bg-yellow-100 text-yellow-700">
                  pending
                </span>
                {{/if}}

                {{#if (eq status "in-progress")}}
                <span class="px-3 py-1 text-xs rounded-full bg-blue-100 text-blue-700">
                  in-progress
                </span>
                {{/if}}

                {{#if (eq status "completed")}}
                <span class="px-3 py-1 text-xs rounded-full bg-green-100 text-green-700">
                  completed
                </span>
                {{/if}}
              </td>

              <td class="py-4 text-gray-600">
                {{notes}}
              </td>

              <td class="py-4 text-gray-500">
                {{assignedAt}}
              </td>

              <td class="py-4">

                {{#if (eq status "pending")}}
                <form method="POST" action="/housekeeping/start/{{id}}">
                  <button class="px-4 py-1.5 rounded-lg bg-gray-200 hover:bg-gray-300 text-sm transition">
                    Start
                  </button>
                </form>
                {{/if}}

                {{#if (eq status "in-progress")}}
                <form method="POST" action="/housekeeping/complete/{{id}}">
                  <button class="px-4 py-1.5 rounded-lg bg-[#0a5c56] hover:bg-[#084843] text-white text-sm transition">
                    Complete
                  </button>
                </form>
                {{/if}}

              </td>

            </tr>
            {{/each}}

            {{#unless tasks.length}}
            <tr>
              <td colspan="5" class="py-12 text-center text-gray-400">
                No tasks assigned today
              </td>
            </tr>
            {{/unless}}

          </tbody>

        </table>
      </div>

    </div>

  </main>

  <!-- Logout Confirmation Modal -->
  <div id="logoutModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center">
    <div class="bg-white rounded-lg shadow-xl p-5 max-w-xs w-full mx-4 animate-fadeIn">
      <div class="text-center mb-4">
        <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-3">
          <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-800 mb-1">Confirm Logout</h3>
        <p class="text-sm text-gray-600">Are you sure?</p>
      </div>
      <div class="flex gap-2">
        <button onclick="hideLogoutModal()" class="flex-1 bg-gray-200 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-300 transition font-medium text-sm">
          Cancel
        </button>
        <a href="/logout" class="flex-1 bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition font-medium text-center text-sm">
          Yes, Logout
        </a>
      </div>
    </div>
  </div>

  <script>
    function showLogoutModal() {
      document.getElementById('logoutModal').classList.remove('hidden');
    }
    function hideLogoutModal() {
      document.getElementById('logoutModal').classList.add('hidden');
    }
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') hideLogoutModal();
    });

    // Mobile menu toggle
    function toggleMobileMenu() {
      const menu = document.getElementById('mobile-menu');
      const menuIcon = document.getElementById('menu-icon');
      const closeIcon = document.getElementById('close-icon');
      
      menu.classList.toggle('hidden');
      menuIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    }
  </script>

</div>

<!-- ================= FADE ANIMATION ================= -->
<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeIn {
    animation: fadeIn 0.6s ease-out forwards;
  }
</style>